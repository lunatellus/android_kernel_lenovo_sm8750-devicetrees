&soc {
	ddr_cti0: cti@11502000 {
		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x11502000 0x1000>;

		arm,primecell-periphid = <0x000bb922>;
		device-name = "cti_ddr0";
		qcom,extended_cti;
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	ddr_cti1: cti@11508000 {
		compatible = "arm,coresight-cti", "arm,primecell";
