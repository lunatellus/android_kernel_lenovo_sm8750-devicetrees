		vreg-0p9-supply = <&L3I>;
		vreg-qref-supply = <&L3J>;
		vreg-cx-supply = <&VDD_CX_LEVEL>;
		vreg-mx-supply = <&VDD_MXA_LEVEL>;
		/* <max min opt> */
		qcom,vreg-1p2-voltage-level = <1200000 1200000 20000>;
		qcom,vreg-0p9-voltage-level = <880000 880000 97000>;
		qcom,vreg-qref-voltage-level = <880000 880000 1300>;
		qcom,vreg-cx-voltage-level = <RPMH_REGULATOR_LEVEL_MAX
						RPMH_REGULATOR_LEVEL_LOW_SVS 0>;
		qcom,vreg-mx-voltage-level = <RPMH_REGULATOR_LEVEL_MAX
						RPMH_REGULATOR_LEVEL_LOW_SVS 0>;
		clocks = <&gcc GCC_PCIE_4_PIPE_CLK>,
			<&rpmhcc RPMH_CXO_CLK>,
			<&gcc GCC_PCIE_4_AUX_CLK>,
			<&gcc GCC_PCIE_4_CFG_AHB_CLK>,
			<&gcc GCC_PCIE_4_MSTR_AXI_CLK>,
			<&gcc GCC_PCIE_4_SLV_AXI_CLK>,
