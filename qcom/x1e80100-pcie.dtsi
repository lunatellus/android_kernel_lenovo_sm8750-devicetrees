				 0 0 0 4 &intc 0 0 GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;

		msi-parent = <&pcie4_msi>;

		perst-gpio = <&tlmm 146 GPIO_ACTIVE_HIGH>;
		wake-gpio = <&tlmm 148 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default", "sleep";
