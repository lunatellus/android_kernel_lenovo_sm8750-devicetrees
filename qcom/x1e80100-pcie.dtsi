		reset-names = "pcie_4_core_reset",
				"pcie_4_phy_reset";

		dma-coherent;

		/* x1e80100 has SMMUv3 */
		iommu-map = <0x0 &pcie_smmu 0x40000 0x1>,
			    <0x100 &pcie_smmu 0x40100 0x1>;

		qcom,boot-option = <0x1>;
		qcom,aux-clk-freq = <20>; /* 19.2 MHz */
		qcom,drv-l1ss-timeout-us = <5000>;
		qcom,l1-2-th-scale = <2>;
		qcom,l1-2-th-value = <150>;
		qcom,ep-latency = <10>;
		qcom,num-parf-testbus-sel = <0xb9>;
