&soc {
	csr: csr@8001000 {
		compatible = "qcom,coresight-csr";
		reg = <0x08001000 0x1000>;
		reg-names = "csr-base";

		device-name = "csr";

		qcom,set-byte-cntr-support;
	};

	swao_csr: csr@8a03000 {
		compatible = "qcom,coresight-csr";
		reg = <0x8a03000 0x1000>;
		reg-names = "csr-base";

		device-name = "swao_csr";

		qcom,timestamp-support;
		qcom,aodbg-csr-support;
		qcom,timestamp-reg-offset = <0x14>;

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";
	};

	apss_tgu: tgu@9840000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;
		reg = <0x09840000 0x1000>;
		reg-names = "tgu-base";
		tgu-steps = <2>;
		tgu-conditions = <3>;
		tgu-regs = <7>;

		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;

		device-name = "tgu_apss";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";
	};

	snoc: snoc {
		compatible = "arm,coresight-dummy-source";

		device-name = "snoc";
		trace-name = "snoc";

		atid = <18>;

		out-ports {
			port {
				snoc_out_funnel_in0: endpoint {
					remote-endpoint =
					<&funnel_in0_in_snoc>;
				};
			};
		};
	};

	tpdm_dcc: tpdm@8003000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08003000 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <32>;

		device-name = "tpdm_dcc";

		qcom,hw-enable-check;
		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_dcc_out_tpda_qdss: endpoint {
					remote-endpoint =
					<&tpda_qdss_in_tpdm_dcc>;
				};
			};
		};
	};

	tpdm_spdm: tpdm@800f000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x0800f000 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <32>;

		device-name = "tpdm_spdm";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_spdm_out_tpda_qdss: endpoint {
					remote-endpoint =
					<&tpda_qdss_in_tpdm_spdm>;
				};
			};
		};
	};

	tpda_qdss: tpda@8004000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0f00>;
		reg = <0x08004000 0x1000>;
		reg-names = "tpda-base";

		device-name = "tpda_qdss";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				tpda_qdss_in_tpdm_dcc: endpoint {
					remote-endpoint =
					<&tpdm_dcc_out_tpda_qdss>;
				};
			};

			port@1 {
				reg = <1>;
				tpda_qdss_in_tpdm_spdm: endpoint {
					remote-endpoint =
					<&tpdm_spdm_out_tpda_qdss>;
				};
			};
		};

		out-ports {
			port {
				tpda_qdss_out_funnel_in0: endpoint {
					remote-endpoint =
					<&funnel_in0_in_tpda_qdss>;
				};
			};
		};
	};

	stm: stm@8002000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb962>;
		reg = <0x08002000 0x1000>,
			<0x0e280000 0x180000>;
		reg-names = "stm-base", "stm-stimulus-base";

		atid = <16>;

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				stm_out_funnel_in0: endpoint {
					remote-endpoint =
					<&funnel_in0_in_stm>;
				};
			};
		};
	};

	funnel_in0: funnel@8041000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb908>;
		reg = <0x08041000 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_in0";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@5 {
				reg = <5>;
				funnel_in0_in_snoc: endpoint {
					remote-endpoint =
					<&snoc_out_funnel_in0>;
				};
			};

			port@6 {
				reg = <6>;
				funnel_in0_in_tpda_qdss: endpoint {
					remote-endpoint =
					<&tpda_qdss_out_funnel_in0>;
				};
			};

			port@7 {
				reg = <7>;
				funnel_in0_in_stm: endpoint {
					remote-endpoint =
					<&stm_out_funnel_in0>;
				};
			};
		};

		out-ports {
			port {
				funnel_in0_out_funnel_merg: endpoint {
					remote-endpoint =
					<&funnel_merg_in_funnel_in0>;
				};
			};
		};
	};

	tpdm_mapss: tpdm@8a01000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08a01000 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <32>;
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		device-name = "tpdm_mapss";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_mapss_out_tpda_aodbg: endpoint {
					remote-endpoint =
					<&tpda_aodbg_in_tpdm_mapss>;
				};
			};
		};
	};

	tpda_aodbg: tpda@8a04000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0f00>;
		reg = <0x08a04000 0x1000>;
		reg-names = "tpda-base";

		device-name = "tpda_aodbg";

		qcom,legacy-timestamp-en;

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port {
				tpda_aodbg_in_tpdm_mapss: endpoint {
					remote-endpoint =
					<&tpdm_mapss_out_tpda_aodbg>;
				};
			};
		};

		out-ports {
			port {
				tpda_aodbg_out_funnel_in1: endpoint {
					remote-endpoint =
					<&funnel_in1_in_tpda_aodbg>;
				};
			};
		};
	};

	tpdm_wcss: tpdm@899c000 {
		compatible = "arm,coresight-dummy-source";

		device-name = "tpdm_wcss";
		trace-name = "tpdm_wcss";

		atid = <24>;

		out-ports {
			port {
				tpdm_wcss_out_funnel_in1: endpoint {
					remote-endpoint =
					<&funnel_in1_in_tpdm_wcss>;
				};
			};
		};
	};

	modem_etm0: modem_etm0 {
		compatible = "qcom,coresight-remote-etm";

		device-name = "modem_etm0";
		qcom,atid-num = <1>;
		atid = <36>;
		trace-name = "modem-etm0";

		out-ports {
			port@0 {
				reg = <0>;
				modem_etm_out_funnel_in1: endpoint {
					remote-endpoint =
						<&funnel_modem_in1_in_modem_etm>;
				};
			};

			port@1 {
				reg = <1>;
				modem_etm_out_qmi: endpoint {
					remote-endpoint =
						<&qmi_in_modem_etm>;
				};
			};
		};
	};

	etm0: etm@9040000 {
		compatible = "arm,coresight-etm4x-sysreg";

		reg = <0x09040000 0x1000>;
		cpu = <&CPU0>;

		device-name = "etm0";

		qcom,skip-power-up;
		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				etm0_out_funnel_cpuss_0: endpoint {
				remote-endpoint = <&funnel_cpuss_0_in_etm0>;
				};
			};
		};
	};

	etm1: etm@9140000 {
		compatible = "arm,coresight-etm4x-sysreg";

		reg = <0x09140000 0x1000>;
		cpu = <&CPU1>;

		device-name = "etm1";

		qcom,skip-power-up;
		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				etm1_out_funnel_cpuss_0: endpoint {
				remote-endpoint = <&funnel_cpuss_0_in_etm1>;
				};
			};
		};
	};

	etm2: etm@9240000 {
		compatible = "arm,coresight-etm4x-sysreg";

		reg = <0x09240000 0x1000>;
		cpu = <&CPU2>;

		device-name = "etm2";

		qcom,skip-power-up;
		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				etm2_out_funnel_cpuss_0: endpoint {
				remote-endpoint = <&funnel_cpuss_0_in_etm2>;
				};
			};
		};
	};

	etm3: etm@9340000 {
		compatible = "arm,coresight-etm4x-sysreg";

		reg = <0x09340000 0x1000>;
		cpu = <&CPU3>;

		device-name = "etm3";

		qcom,skip-power-up;
		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				etm3_out_funnel_cpuss_0: endpoint {
				remote-endpoint = <&funnel_cpuss_0_in_etm3>;
				};
			};
		};
	};

	funnel_cpuss_0: funnel@9800000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb908>;
		reg = <0x09800000 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_cpuss_0";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				funnel_cpuss_0_in_etm0: endpoint {
					remote-endpoint =
					<&etm0_out_funnel_cpuss_0>;
				};
			};

			port@1 {
				reg = <1>;
				funnel_cpuss_0_in_etm1: endpoint {
					remote-endpoint =
					<&etm1_out_funnel_cpuss_0>;
				};
			};

			port@2 {
				reg = <2>;
				funnel_cpuss_0_in_etm2: endpoint {
					remote-endpoint =
					<&etm2_out_funnel_cpuss_0>;
				};
			};

			port@3 {
				reg = <3>;
				funnel_cpuss_0_in_etm3: endpoint {
					remote-endpoint =
					<&etm3_out_funnel_cpuss_0>;
				};
			};
		};

		out-ports {
			port {
				funnel_cpuss_0_out_funnel_cpuss_1: endpoint {
					remote-endpoint =
					<&funnel_cpuss_1_in_funnel_cpuss_0>;
				};
			};
		};
	};

	tpdm_llm_silver: tpdm@98a0000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x098a0000 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <32>;
		qcom,cmb-msrs-num = <12>;

		device-name = "tpdm_llm_silver";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_llm_silver_out_tpda_apss: endpoint {
					remote-endpoint =
					<&tpda_apss_in_tpdm_llm_silver>;
				};
			};
		};
	};

	tpdm_actpm: tpdm@9860000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x09860000 0x1000>;
		reg-names = "tpdm-base";
		qcom,cmb-element-bits = <64>;
		qcom,cmb-msrs-num = <1>;

		device-name = "tpdm_actpm";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_actpm_out_tpda_apss: endpoint {
					remote-endpoint =
					<&tpda_apss_in_tpdm_actpm>;
				};
			};
		};
	};

	tpdm_hwe: tpdm@9861000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x09861000 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <32>;

		device-name = "tpdm_hwe";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_hwe_out_tpda_apss: endpoint {
					remote-endpoint =
					<&tpda_apss_in_tpdm_hwe>;
				};
			};
		};
	};

	tpda_apss: tpda@9863000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0f00>;
		reg = <0x09863000 0x1000>;
		reg-names = "tpda-base";

		device-name = "tpda_apss";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				tpda_apss_in_tpdm_llm_silver: endpoint {
					remote-endpoint =
					<&tpdm_llm_silver_out_tpda_apss>;
				};
			};

			port@2 {
				reg = <2>;
				tpda_apss_in_tpdm_actpm: endpoint {
					remote-endpoint =
					<&tpdm_actpm_out_tpda_apss>;
				};
			};

			port@3 {
				reg = <3>;
				tpda_apss_in_tpdm_hwe: endpoint {
					remote-endpoint =
					<&tpdm_hwe_out_tpda_apss>;
				};
			};
		};

		out-ports {
			port {
				tpda_apss_out_funnel_cpuss_1: endpoint {
					remote-endpoint =
					<&funnel_cpuss_1_in_tpda_apss>;
				};
			};
		};
	};

	funnel_cpuss_1: funnel@9810000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb908>;
		reg = <0x09810000 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_cpuss_1";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				funnel_cpuss_1_in_funnel_cpuss_0: endpoint {
					remote-endpoint =
					<&funnel_cpuss_0_out_funnel_cpuss_1>;
				};
			};

			port@3 {
				reg = <3>;
				funnel_cpuss_1_in_tpda_apss: endpoint {
					remote-endpoint =
					<&tpda_apss_out_funnel_cpuss_1>;
				};
			};
		};

		out-ports {
			port {
				funnel_cpuss_1_out_funnel_in1: endpoint {
					remote-endpoint =
					<&funnel_in1_in_funnel_cpuss_1>;
				};
			};
		};
	};

	tpdm_mcu: tpdm@8980000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08980000 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		device-name = "tpdm_mcu";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_mcu_out_funnel_mcu: endpoint {
					remote-endpoint =
					<&funnel_mcu_in_tpdm_mcu>;
				};
			};
		};
	};

	funnel_mcu: funnel@8982000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb908>;
		reg = <0x08982000 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_mcu";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				funnel_mcu_in_tpdm_mcu: endpoint {
					remote-endpoint =
					<&tpdm_mcu_out_funnel_mcu>;
				};
			};
		};

		out-ports {
			port {
				funnel_mcu_out_tpda_center: endpoint {
					remote-endpoint =
					<&tpda_center_in_funnel_mcu>;
				};
			};
		};
	};

	tpdm_gfx: tpdm@8940000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08940000 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <4>;

		device-name = "tpdm_gfx";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		status = "disabled";

		out-ports {
			port {
				tpdm_gfx_out_funnel_gfx: endpoint {
					remote-endpoint =
					<&funnel_gfx_in_tpdm_gfx>;
				};
			};
		};
	};

	funnel_gfx: funnel@8944000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb908>;
		reg = <0x08944000 0x1000>;
		reg-names = "funnel-base";

		device-name = "funnel_gfx";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		status = "disabled";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port {
				funnel_gfx_in_tpdm_gfx: endpoint {
					remote-endpoint =
					<&tpdm_gfx_out_funnel_gfx>;
				};
			};
