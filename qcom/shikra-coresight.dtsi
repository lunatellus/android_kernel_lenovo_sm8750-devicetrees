		out-ports {
			port {
				funnel_gfx_out_tpda_center: endpoint {
					remote-endpoint =
					<&tpda_center_in_funnel_gfx>;
				};
			};
		};
	};

	tpdm_dlct: tpdm@8b58000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08b58000 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		device-name = "tpdm_dlct";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_dlct_out_tpda_center: endpoint {
					remote-endpoint =
					<&tpda_center_in_tpdm_dlct>;
				};
			};
		};
	};

	tpdm_turing: tpdm@8800000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x08800000 0x1000>;
		reg-names = "tpdm-base";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <4>;

		device-name = "tpdm_turing";

		clocks = <&rpmcc RPM_SMD_QDSS_CLK>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				tpdm_turing_out_funnel_turing: endpoint {
					remote-endpoint =
					<&funnel_turing_in_tpdm_turing>;
				};
			};
		};
	};

	turing_etm0: turing_etm0 {
		compatible = "qcom,coresight-remote-etm";

		device-name = "turing_etm0";

		qcom,atid-num = <1>;
		atid = <38>;
		trace-name = "turing-etm0";

		out-ports {
			port@0 {
				reg = <0>;
				turing_etm0_out_funnel_turing: endpoint {
					remote-endpoint =
						<&funnel_turing_in_turing_etm0>;
				};
			};

			port@1 {
				reg = <1>;
				turing_etm0_out_qmi: endpoint {
