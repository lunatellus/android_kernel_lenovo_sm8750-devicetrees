			thermal-hal-config {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};

			nsp_0_trip: nsp-0-trip {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			cdsp_cdev {
				trip = <&nsp_0_trip>;
				cooling-device = <&cdsp_sw 0 THERMAL_NO_LIMIT>;
			};
		};
	};

	mdm-0-thermal {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 8>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
