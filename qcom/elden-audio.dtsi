		swr0: wsa_swr_master {
			qcom,dynamic-port-map-supported = <0x0>;
			qcom,swr-num-dev = <0x2>;
			qcom,swr-port-mapping = <0x1 0x1 0x1 0x2 0x2 0xf 0x3 0x3 0x3 0x4 0x4 0x1 0x5 0x5 0xf 0x6 0x6 0x3 0x7 0x7 0x3 0x8 0x8 0x3 0x9 0x9 0x3 0xa 0xa 0x3 0xb 0xb 0x3 0xc 0xc 0x3 0xd 0xd 0x3>;
