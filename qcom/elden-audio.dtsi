			interrupt-names = "swr_master_irq";
			interrupts = <0x0 0x9b 0x4>;
			swrm-io-base = <0x6ad0000 0x0>;
			qcom,mipi-sdw-block-packing-mode = <0x1>;
			qcom,swr_master_id = <0x2>;
