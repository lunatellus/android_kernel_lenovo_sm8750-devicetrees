/* stock fragment@70 */
&lpass_cdc {
	#size-cells = <0x1>;
	#address-cells = <0x1>;
	qcom,lpass-cdc-version = <0x7>;
	qcom,num-macros = <0x3>;

	lpass-cdc-clk-rsc-mngr {
		clocks = <&clock_audio_tx_1 0x0 &clock_audio_rx_1 0x0 &clock_audio_rx_tx 0x0 &clock_audio_va_1 0x0>;
		clock-names = "tx_core_clk", "rx_core_clk", "rx_tx_core_clk", "va_core_clk";
		qcom,wsa_mclk_mode_muxsel = <0x6bea110>;
		qcom,rx_mclk_mode_muxsel = <0x6bec0d8>;
		qcom,fs-gen-sequence = <0x3000 0x1 0x1 0x3004 0x3 0x3 0x3004 0x3 0x1 0x3080 0x2 0x2>;
		compatible = "qcom,lpass-cdc-clk-rsc-mngr";
	};

	va_macro: va-macro@7660000 {
		qcom,va-swr-gpios = <&va_swr_gpios>;
		qcom,is-used-swr-gpio = <0x1>;
		qcom,use-clk-id = <0x3>;
		qcom,default-clk-id = <0x0>;
		qcom,va-clk-mux-select = <0x1>;
		qcom,va-dmic-clk-div-factor = <0x10 0x10 0x10 0x10>;
		clocks = <&lpass_audio_hw_vote 0x0>;
		clock-names = "lpass_audio_hw_vote";
		reg = <0x7660000 0x0>;
		compatible = "qcom,lpass-cdc-va-macro";

		swr2: va_swr_master {
			qcom,is-always-on = <0x1>;
			qcom,swr-mstr-irq-wakeup-capable = <0x1>;
			qcom,swr-clock-stop-mode0 = <0x1>;
			qcom,swr-num-dev = <0x5>;
			qcom,swr-port-mapping = <0x1 0x2d 0x3 0x2 0x2e 0x1 0x2 0x2f 0x2 0x2 0x30 0x4 0x2 0x31 0x8 0x3 0x32 0x1 0x3 0x33 0x2 0x3 0x34 0x4 0x3 0x35 0x8 0x4 0x36 0x1 0x4 0x37 0x2 0x4 0x38 0x4 0x4 0x39 0x8 0x5 0x3a 0x3>;
			qcom,swr-num-ports = <0x5>;
			qcom,swr-wakeup-required = <0x1>;
			interrupt-names = "swr_master_irq", "swr_wake_irq";
			interrupts = <0x0 0x2f9 0x4 0x0 0x311 0x4>;
			swrm-io-base = <0x7630000 0x0>;
			qcom,mipi-sdw-block-packing-mode = <0x1>;
			qcom,swr_master_id = <0x3>;
			clocks = <&lpass_core_hw_vote 0x0 &lpass_audio_hw_vote 0x0>;
			clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
			#size-cells = <0x0>;
			#address-cells = <0x2>;
			compatible = "qcom,swr-mstr";

			wcd939x_tx_slave: wcd939x-tx-slave {
				reg = <0xe 0x1170223>;
				compatible = "qcom,wcd939x-slave";
			};
		};
	};

	tx_macro: tx-macro@6AE0000 {
		qcom,is-used-swr-gpio = <0x0>;
		qcom,tx-dmic-clk-div-factor = <0x4 0x4 0x4 0x4>;
		qcom,default-clk-id = <0x0>;
		reg = <0x6ae0000 0x0>;
		compatible = "qcom,lpass-cdc-tx-macro";
	};

	rx_macro: rx-macro@6AC0000 {
		clocks = <&clock_audio_rx_mclk2_2x_clk 0x0>;
		clock-names = "rx_mclk2_2x_clk";
		qcom,default-clk-id = <0x5>;
		qcom,rx-bcl-pmic-params = [00 03 48];
		qcom,rx_mclk_mode_muxsel = <0x6bec0d8>;
		qcom,rx-swr-gpios = <&rx_swr_gpios>;
		reg = <0x6ac0000 0x0>;
		compatible = "qcom,lpass-cdc-rx-macro";

		swr1: rx_swr_master {
			qcom,swr-clock-stop-mode0 = <0x1>;
			qcom,swr-num-dev = <0x1>;
			qcom,swr-port-mapping = <0x1 0xe 0x1 0x1 0xf 0x2 0x2 0x12 0x3 0x3 0x10 0x1 0x3 0x11 0x2 0x4 0x13 0x1 0x5 0x14 0x1 0x5 0x15 0x2 0x6 0x16 0x1 0x7 0x17 0x3 0x8 0x18 0x3 0x9 0x3b 0x1 0x9 0x3c 0x2 0xa 0x1a 0x3 0xb 0x1b 0x3 0xc 0x1c 0x3>;
