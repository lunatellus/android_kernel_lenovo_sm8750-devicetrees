			};
		};
	};

	wsa_macro: wsa-macro@6B00000 {
		#cooling-cells = <0x2>;
		qcom,noise-gate-mode = <0x2>;
		qcom,thermal-max-state = <0xb>;
		qcom,default-clk-id = <0x6>;
		qcom,wsa-bcl-pmic-params = [00 03 48];
		qcom,wsa-system-gains = <0x0 0x9 0x0 0x9>;
		qcom,wsa-rloads = <0x2 0x2>;
		qcom,wsa-bat-cfgs = <0x1 0x1>;
		qcom,wsa-swr-gpios = <&wsa_swr_gpios>;
		wsa_data_fs_ctl_reg = <0x6b6f000>;
		reg = <0x6b00000 0x0>;
		compatible = "qcom,lpass-cdc-wsa-macro";
