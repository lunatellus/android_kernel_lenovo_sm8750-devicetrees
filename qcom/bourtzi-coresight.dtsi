&soc {
	audio_etm0 {
		compatible = "qcom,coresight-remote-etm";

		device-name = "audio_etm0";
		qcom,atid-num = <1>;
		trace-name = "audio-etm0";
		atid = <40>;

		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				audio_etm0_out_funnel_lpass_lpi: endpoint {
					remote-endpoint =
					<&funnel_lpass_lpi_in_audio_etm0>;
				};
			};

			port@1 {
				reg = <1>;
				audio_etm0_out_qmi: endpoint {
					remote-endpoint =
					<&qmi_in_audio_etm0>;
				};
			};
		};
	};

	tpdm_lpass_lpi: tpdm_lpass_lpi {
		compatible = "arm,coresight-dummy-source";
		device-name = "tpdm_lpass_lpi";
		trace-name = "tpda-lpass-lpi";
		atid = <26>;

		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				tpdm_lpass_lpi_out_funnel_lpass_lpi: endpoint {
					remote-endpoint =
					<&funnel_lpass_lpi_in_tpdm_lpass_lpi>;
				};
			};

			port@1 {
				reg = <1>;
				lpass_lpi_out_qmi: endpoint {
					remote-endpoint =
					<&qmi_in_lpass_lpi>;
				};
			};
		};
	};

	tpdm_lpass: tpdm@10844000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x0 0x10844000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm_lpass";
		trace-name = "tpdm-lpass";
		qcom,dsb-element-bits = <32>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		atid = <74>;
		out-ports {
			port {
				tpdm_lpass_out_funnel_lpass: endpoint {
					remote-endpoint =
					<&funnel_lpass_in_tpdm_lpass>;
				};
			};
		};
	};

	tpdm_dl_lpass: tpdm@10c38000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000f0e00>;
		reg = <0x0 0x10c38000 0x0 0x1000>;
		reg-names = "tpdm-base";

		device-name = "tpdm_dl_lpass";
		trace-name = "tpdm-dl-lpass";

		qcom,dsb-element-bits = <32>;
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		atid = <74>;
		out-ports {
			port {
				tpdm_dl_lpass_out_tpda_dl_lpass_10: endpoint {
					remote-endpoint =
					<&tpda_dl_lpass_10_in_tpdm_dl_lpass>;
				};
			};
		};
	};

	lpass_stm: lpass_stm {
		compatible = "arm,coresight-dummy-source";
		device-name = "lpass_stm";
		trace-name = "lpass-stm";

		atid = <25>;

		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				lpass_stm_out_funnel_lpass_lpi: endpoint {
