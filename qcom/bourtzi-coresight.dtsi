		};
	};

	audio-qmi {
		compatible = "qcom,coresight-qmi";

		device-name = "qmi-audio";
		qcom,inst-id = <5>;
		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				qmi_in_audio_etm0: endpoint {
					remote-endpoint =
						<&audio_etm0_out_qmi>;
				};
			};

			port@1 {
				reg = <1>;
				qmi_in_lpass_stm: endpoint {
					remote-endpoint =
					<&lpass_stm_out_qmi>;
				};
			};

			port@2 {
				reg = <2>;
				qmi_in_lpass_lpi: endpoint {
					remote-endpoint =
					<&lpass_lpi_out_qmi>;
				};
			};
		};
	};

