		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x11461000 0x1000>;

		arm,primecell-periphid = <0x000bb922>;
		device-name = "cti-mdss";
		qcom,extended_cti;
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	ipcb_tgu: tgu@1130e000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;
		reg = <0x1130e000 0x1000>;
		reg-names = "tgu-base";
		tgu-steps = <2>;
		tgu-conditions = <4>;
		tgu-regs = <4>;

		device-name = "tgu_ipcb";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu0: tgu@1130f000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x1130f000 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <3>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi0";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	spmi_tgu1: tgu@11310000 {
		compatible = "arm,primecell";
		arm,primecell-periphid = <0x000bb999>;

		reg = <0x11310000 0x1000>;
		reg-names = "tgu-base";

		tgu-steps = <2>;
		tgu-conditions = <4>;
		tgu-regs = <8>;

		device-name = "tgu_spmi1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	csr: csr@10001000 {
		compatible = "qcom,coresight-csr";
		reg = <0x10001000 0x1000>;
		reg-names = "csr-base";

		device-name = "csr";

		qcom,hwctrl-set-support;
		qcom,set-byte-cntr-support;
		qcom,blk-size = <1>;
	};

	swao_csr: csr@11311000 {
		compatible = "qcom,coresight-csr";
		reg = <0x11311000 0x1000>,
			<0x113110f8 0x90>;
		reg-names = "csr-base", "msr-base";

		device-name = "swao_csr";

		qcom,timestamp-support;
		qcom,msr-support;
		qcom,blk-size = <1>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
	};

	gpu_tpdm_gpu: tpdm@11100000 {
		compatible = "qcom,coresight-tpdm","arm,primecell";
		reg = <0x11100000 0x1000>;

		reg-names = "tpdm-base";
		device-name = "tpdm_gpu";

		status = "disabled";
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <8>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		out-ports {
			port {
				gpu_tpdm_gpu_out_gpu_dl_0: endpoint {
					remote-endpoint =
						<&gpu_dl_0_in_gpu_tpdm_gpu>;
				};
			};
		};
	};

	gpu_dl: funnel@11102000 {
		compatible = "arm,coresight-dynamic-funnel","arm,primecell";
		reg = <0x11102000 0x1000>;

		reg-names = "funnel-base";
		device-name = "funnel_gpu";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		status = "disabled";
		in-ports {
			port@0 {
				gpu_dl_0_in_gpu_tpdm_gpu: endpoint {
					remote-endpoint =
						<&gpu_tpdm_gpu_out_gpu_dl_0>;
				};
			};
		};

		out-ports {
			port@0 {
				gpu_dl_out_tpda_dlct_0_19: endpoint {
					remote-endpoint =
						<&tpda_dlct_0_19_in_gpu_dl>;
				};
			};
		};
	};

	ddr_tpdm_lpicc_dsb: tpdm@11330000 {
		compatible = "arm,coresight-dummy-source";
		device-name = "tpdm_ddr_lpi";
		trace-name = "tpda-ddr-lpi";
		out-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				ddr_tpdm_lpicc_dsb_out_ddr_lpi_funnel_0: endpoint {
					remote-endpoint =
						<&ddr_lpi_funnel_0_in_ddr_tpdm_lpicc_dsb>;
				};
			};

			port@1 {
				reg = <1>;
				ddr_lpi_out_qmi: endpoint {
					remote-endpoint =
					<&qmi_in_ddr_lpi>;
				};
			};
		};
	};

	ddr_lpi_funnel: funnel@11333000 {
		compatible = "arm,coresight-static-funnel";
		device-name = "funnel_ddr_lpi";

		in-ports {
			port@0 {
				ddr_lpi_funnel_0_in_ddr_tpdm_lpicc_dsb: endpoint {
					remote-endpoint =
						<&ddr_tpdm_lpicc_dsb_out_ddr_lpi_funnel_0>;
				};
			};
		};

		out-ports {
			port {
				ddr_lpi_funnel_out_aoss_3: endpoint {
					remote-endpoint =
						<&aoss_3_in_ddr_lpi_funnel>;
				};
			};
		};
	};

	ddr_tpdm_channel_0_2: tpdm@11520000 {
		compatible = "qcom,coresight-tpdm","arm,primecell";
		reg = <0x11520000 0x1000>;

		reg-names = "tpdm-base";
		device-name = "tpdm_ddr_ch02";

		qcom,cmb-element-bits = <32>;
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <16>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_channel_0_2_out_ddr_ch_0_2_dl_0: endpoint {
					remote-endpoint =
						<&ddr_ch_0_2_dl_0_in_ddr_tpdm_channel_0_2>;
				};
			};
		};
	};

	ddr_ch_0_2_dl: funnel@11522000 {
		compatible = "arm,coresight-dynamic-funnel","arm,primecell";
		reg = <0x11522000 0x1000>;

		reg-names = "funnel-base";
		device-name = "funnel_ddr_ch02";
		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		in-ports {
			port@0 {
				ddr_ch_0_2_dl_0_in_ddr_tpdm_channel_0_2: endpoint {
					remote-endpoint =
						<&ddr_tpdm_channel_0_2_out_ddr_ch_0_2_dl_0>;
				};
			};
		};

		out-ports {
			port {
				ddr_ch_0_2_dl_out_dl_0_ddr_0: endpoint {
					remote-endpoint =
						<&dl_0_ddr_0_in_ddr_ch_0_2_dl>;
				};
			};
		};
	};

	ddr_tpdm_ddr_dl_0_dsb_cmb: tpdm@11500000 {
		compatible = "qcom,coresight-tpdm","arm,primecell";
		reg = <0x11500000 0x1000>;

		reg-names = "tpdm-base";
		device-name = "tpdm_ddr_dl0";

		qcom,cmb-element-bits = <32>;
		qcom,dsb-element-bits = <32>;
		qcom,dsb-msrs-num = <32>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_ddr_dl_0_dsb_cmb_out_dl_0_ddr_2: endpoint {
					remote-endpoint =
						<&dl_0_ddr_2_in_ddr_tpdm_ddr_dl_0_dsb_cmb>;
				};
			};
		};
	};

	ddr_tpdm_ddr_dpm: tpdm@11501000 {
		compatible = "qcom,coresight-tpdm","arm,primecell";
		reg = <0x11501000 0x1000>;

		reg-names = "tpdm-base";
		device-name = "tpdm_ddr_dpm";

		qcom,cmb-element-bits = <64>;

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		out-ports {
			port {
				ddr_tpdm_ddr_dpm_out_dl_0_ddr_3: endpoint {
					remote-endpoint =
						<&dl_0_ddr_3_in_ddr_tpdm_ddr_dpm>;
				};
			};
		};
	};

	gladiator: gladiator {
		compatible = "arm,coresight-dummy-source";
		device-name = "gladiator";
		atid = <96>;

		out-ports {
			port {
				gladiator_out_dl_1_ddr: endpoint {
					remote-endpoint =
					<&dl_1_ddr_in_gladiator>;
				};
			};
		};
	};

	tpda_llcc: tpda@11509000 {
		compatible = "qcom,coresight-tpda","arm,primecell";
		reg = <0x11509000 0x1000>;

		reg-names = "tpda-base";
		device-name = "tpda_ddr_llcc";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				tpda_llcc_0_in_ddr_tpdm_llcc_0: endpoint {
					remote-endpoint =
						<&ddr_tpdm_llcc_0_out_tpda_llcc_0>;
				};
			};

			port@1 {
				reg = <1>;
				tpda_llcc_1_in_ddr_tpdm_llcc_1: endpoint {
					remote-endpoint =
						<&ddr_tpdm_llcc_1_out_tpda_llcc_1>;
				};
			};
		};

		out-ports {
			port {
				tpda_llcc_out_dl_1_ddr_0: endpoint {
					remote-endpoint =
						<&dl_1_ddr_0_in_tpda_llcc>;
				};
			};
		};
	};

	dl_1_ddr: funnel@1150a000 {
		compatible = "arm,coresight-dynamic-funnel","arm,primecell";
		reg = <0x1150a000 0x1000>;

		reg-names = "funnel-base";
		device-name = "funnel_ddr_dl1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				dl_1_ddr_0_in_tpda_llcc: endpoint {
					remote-endpoint =
						<&tpda_llcc_out_dl_1_ddr_0>;
				};
			};

			port@3 {
				reg = <3>;
				dl_1_ddr_in_gladiator: endpoint {
					remote-endpoint =
					<&gladiator_out_dl_1_ddr>;
				};
			};
		};

		out-ports {
			port {
