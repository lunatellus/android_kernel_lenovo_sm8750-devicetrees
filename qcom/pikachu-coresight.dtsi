//		qcom,cti-gpio-trigout = <20>;
//		pinctrl-names = "cti-trigout-pctrl";
//		pinctrl-0 = <&trigout_a>;
	};

	soccp_cti: cti@11381000 {
		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x11381000 0x1000>;

