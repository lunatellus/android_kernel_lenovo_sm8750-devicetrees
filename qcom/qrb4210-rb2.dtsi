#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/qcom,spmi-vadc.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/iio/qti_power_supply_iio.h>

&tlmm {
	/delete-property/ qcom,gpios-reserved;
};

&qupv3_se0_i2c {
	status = "ok";

	ioexp20: i2c0gpio-expander@20 {
		#gpio-cells = <2>;
		compatible = "semtech,sx1508q";
		reg = <0x20>;
		gpio-controller;

		pinctrl-names = "default";
		pinctrl-0 = <&sx1508_cam0a_strobe_active
				&sx1508_cam0b_strobe_active
				&sx1508_cam0b_spare_active>;

		sx1508_cam0a_strobe_active: sx1508_cam0a_strobe_active {
			pins = "gpio0";
			bias-disable;
			output-high;
		};

		sx1508_cam0b_strobe_active: sx1508_cam0b_strobe_active {
			pins = "gpio3";
			bias-disable;
			output-high;
		};

		sx1508_cam0b_spare_active: sx1508_cam0b_spare_active {
			pins = "gpio4";
			bias-disable;
			output-high;
		};
	};

	ioexp21: i2c0gpio-expander@21 {
		#gpio-cells = <2>;
		compatible = "semtech,sx1508q";
		reg = <0x21>;
		gpio-controller;

		pinctrl-names = "default";
		pinctrl-0 = <&sx1508_lcd0_vsn_active
				&sx1508_cam1_pwdn_active>;

		sx1508_lcd0_vsn_active: sx1508_lcd0_vsn_active {
			pins = "gpio1";
			bias-disable;
			output-high;
		};

		sx1508_lcd0_vsn_sleep: sx1508_lcd0_vsn_sleep {
			pins = "gpio1";
			bias-disable;
			output-low;
		};

		sx1508_cam1_pwdn_active: sx1508_cam1_pwdn_active {
			pins = "gpio4";
			bias-disable;
			output-high;
		};
	};

	ioexp22: i2c0gpio-expander@22 {
		#gpio-cells = <2>;
		compatible = "semtech,sx1508q";
		reg = <0x22>;
		gpio-controller;

		pinctrl-names = "default";
		pinctrl-0 = <&sx1508_lcd0_vsp_active>;

		sx1508_lcd0_vsp_active: sx1508_lcd0_vsp_active {
			pins = "gpio7";
			bias-disable;
			output-high;
		};

		sx1508_lcd0_vsp_sleep: sx1508_lcd0_vsp_sleep {
			pins = "gpio7";
			bias-disable;
			output-low;
		};
	};

	ioexp23: i2c0gpio-expander@23 {
		#gpio-cells = <2>;
		compatible = "semtech,sx1508q";
		reg = <0x23>;
		gpio-controller;

		pinctrl-names = "default";
		pinctrl-0 = <&sx1508_cam1_strobe_active
				&sx1508_cam2_strobe_active
				&sx1508_cam2_pwdn_active
				&sx1508_gmsl_power_active>;

		sx1508_cam1_strobe_active: sx1508_cam1_strobe_active {
			pins = "gpio2";
			bias-disable;
			output-high;
		};

		sx1508_cam2_strobe_active: sx1508_cam2_strobe_active {
			pins = "gpio3";
			bias-disable;
			output-high;
		};

		sx1508_cam2_pwdn_active: sx1508_cam2_pwdn_active {
			pins = "gpio5";
			bias-disable;
			output-high;
		};

		sx1508_gmsl_power_active: sx1508_gmsl_power_active {
			pins = "gpio7";
			bias-disable;
			output-high;
		};
	};
};

&qupv3_se1_i2c {
	status = "ok";
	#include "smb1355.dtsi"
};

&pmi632_qg {
	status = "disabled";
};

&pmi632_charger {
	status = "ok";
	qcom,batteryless-platform;
	qcom,lpd-disable;
	qcom,suspend-input-on-debug-batt;
	qcom,sw-jeita-enable;
	qcom,step-charging-enable;
	/* SMB1355 only */
	qcom,sec-charger-config = <2>;
	qcom,hvdcp2-max-icl-ua = <2000000>;
	dpdm-supply = <&qusb_phy0>;
	qcom,charger-temp-max = <800>;
	qcom,smb-temp-max = <800>;
	qcom,auto-recharge-soc = <98>;
	qcom,flash-disable-soc = <10>;
	qcom,hw-die-temp-mitigation;
	qcom,hw-connector-mitigation;
	qcom,connector-internal-pull-kohm = <100>;
	qcom,float-option = <1>;
	qcom,thermal-mitigation = <4200000 3500000 3000000
			2500000 2000000 1500000 1000000 500000>;
};

&pmi632_gpios {
	smb_en {
		smb_en_default: smb_en_default {
			pins = "gpio2";
			function = "func1";
			output-enable;
		};
	};

	pmi632_sense {
		/* GPIO 7 and 8 are external-sense pins for PMI632 */
		pmi632_sense_default: pmi632_sense_default {
			pins = "gpio7", "gpio8";
			bias-high-impedance;	/* disable the GPIO */
			bias-disable;		/* no-pull */
		};
	};

	pmi632_ctm {
		/* Disable GPIO1 for h/w base mitigation */
		pmi632_ctm_default: pmi632_ctm_default {
			pins = "gpio1";
			bias-high-impedance;	/* disable the GPIO */
			bias-disable;		/* no-pull */
		};
	};
};

&pm6125_gpios {
	key_vol_up {
		key_vol_up_default: key_vol_up_default {
			pins = "gpio5";
			function = "normal";
			input-enable;
			bias-pull-up;
			power-source = <0>;
		};
	};
};

&usb0 {
	extcon = <&pmi632_charger>, <&eud>;
};

&qusb_phy0 {
	qcom,qusb-phy-init-seq = <0xf8 0x80
				0xb3 0x84
				0x81 0x88
				0xc7 0x8c
				0x30 0x08
				0x79 0x0c
				0x21 0x10
				0x14 0x9c
				0x80 0x04
				0x9f 0x1c
				0x00 0x18>;
};

&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		vol_up {
			label = "volume_up";
			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			linux,code = <KEY_VOLUMEUP>;
			linux,can-disable;
			debounce-interval = <15>;
			gpio-key,wakeup;
		};
	};

	leds {
		compatible = "gpio-leds";

		wifi_led {
			label = "wifi-led_yellow";
			gpios = <&tlmm 47 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		bt_led {
			label = "bt-led_blue";
			gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		user_led0 {
			label = "user-led0_green";
			gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	fan0: pwm-fan {
		status = "disabled";
		compatible = "pwm-fan";
		pwms = <&pm6125_pwm 0 100000>;
		cooling-levels = <0 32 64 128 170 230 255>;
	};

	clk40M: can_clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};
};

&pmi632_pwm {
	led@3 {
		label = "user-led1_green";
	};

	led@2 {
		label = "user-led2_green";
	};

	led@1 {
		label = "user-led3_green";
	};
};

&qupv3_se5_spi {
	status = "okay";
	mcp2518fd: can@0 {
		compatible = "microchip,mcp2518fd";
		reg = <0>;
		clocks = <&clk40M>;
		interrupt-parent = <&tlmm>;
		interrupts = <39 0>;
		interrupt-names = "can_irq";
		spi-max-frequency = <10000000>;
		message-transmit-interval = <800>;
		gpio-controller;
		status = "okay";
	};
};

&qupv3_se1_i2c {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	qcom,clk-freq-out = <400000>;

	sx1508q: ch_io_expander@22 {
		compatible = "semtech,sx1508q";
		reg = <0x22>;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
		gpio-controller;
	};
};

&sdhc_1 {
	vdd-supply = <&L24A>;
	qcom,vdd-voltage-level = <2960000 2960000>;
	qcom,vdd-current-level = <0 570000>;

	vdd-io-supply = <&L11A>;
	qcom,vdd-io-always-on;
	qcom,vdd-io-lpm-sup;
	qcom,vdd-io-voltage-level = <1800000 1800000>;
	qcom,vdd-io-current-level = <0 325000>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc1_on>;
	pinctrl-1 = <&sdc1_off>;
	status = "ok";
};

&sdhc_2 {
	vdd-supply = <&L22A>;
	qcom,vdd-voltage-level = <2960000 2960000>;
	qcom,vdd-current-level = <0 800000>;

	vdd-io-supply = <&L5A>;
	qcom,vdd-io-voltage-level = <1800000 2960000>;
	qcom,vdd-io-current-level = <0 22000>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;

	cd-gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;

	status = "ok";
};

&tlmm {
	smb_int_default: smb_int_default {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			bias-pull-up;
			input-enable;
		};
	};
};

&smb1355 {
	pinctrl-names = "default";
	pinctrl-0 = <&smb_int_default>;
	interrupt-parent = <&tlmm>;
	interrupts = <105 IRQ_TYPE_LEVEL_LOW>;
	status = "disabled";
};

&smb1355_charger {
	pinctrl-names = "default";
	pinctrl-0 = <&smb_en_default &pmi632_sense_default &pmi632_ctm_default>;
	qcom,parallel-mode = <1>;
	qcom,disable-ctm;
	qcom,hw-die-temp-mitigation;
	status = "disabled";
};

&pm6125_pwm {
	status = "ok";
};

&thermal_zones {
	quiet-therm-step {
		status = "disabled";
	};
};
