#include <dt-bindings/regulator/qcom,rpm-smd-regulator.h>
#include "pm8150-rpm-regulator.dtsi"

&rpm_bus {
	rpm-regulator-smpa1 {
		status = "okay";
		S1A: pm8150_s1: regulator-s1a-e0 {
			regulator-min-microvolt = <788000>;
			regulator-max-microvolt = <988000>;
			qcom,init-voltage = <872000>;
			status = "okay";
		};
	};

	rpm-regulator-smpa3 {
		status = "okay";
		qcom,resource-name = "rwcx";
		qcom,resource-id = <0>;

		VDD_CX_LEVEL:
		S3A_LEVEL: pm8150_s3_level: regulator-s3-level {
			compatible = "qcom,rpm-smd-regulator";
			regulator-name = "pm8150_s3_level";
			qcom,set = <3>;
			regulator-min-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_RETENTION>;
			regulator-max-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_BINNING>;
			qcom,use-voltage-level;
		};

		VDD_CX_FLOOR_LEVEL:
		S3A_FLOOR_LEVEL:
		pm8150_s3_floor_level: regulator-s3-floor-level {
			compatible = "qcom,rpm-smd-regulator";
			regulator-name = "pm8150_s3_floor_level";
			qcom,set = <3>;
			regulator-min-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_RETENTION>;
			regulator-max-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_BINNING>;
			qcom,use-voltage-floor-level;
			qcom,always-send-voltage;
		};

		VDD_CX_LEVEL_AO:
		S3A_LEVEL_AO: pm8150_s3_level_ao: regulator-s3-level-ao {
			compatible = "qcom,rpm-smd-regulator";
			regulator-name = "pm8150_s3_level_ao";
			qcom,set = <3>;
			regulator-min-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_RETENTION>;
			regulator-max-microvolt =
			<RPM_SMD_REGULATOR_LEVEL_BINNING>;
			qcom,use-voltage-level;
		};
	};

	rpm-regulator-smpa4 {
		status = "okay";
		S4A: pm8150_s4: regulator-s4a-e0 {
			regulator-min-microvolt = <1080000>;
			regulator-max-microvolt = <2040000>;
			qcom,init-voltage = <1800000>;
			status = "okay";
		};
	};

	rpm-regulator-smpa5 {
		status = "okay";
		S5A: pm8150_s5: regulator-s5a-e0 {
			regulator-min-microvolt = <1574000>;
			regulator-max-microvolt = <2040000>;
			qcom,init-voltage = <1872000>;
			status = "okay";
		};
	};

	rpm-regulator-smpa6 {
		status = "okay";
		S6A: pm8150_s6: regulator-s6a-e0 {
			regulator-min-microvolt = <382000>;
			regulator-max-microvolt = <1352000>;
			qcom,init-voltage = <1348000>;
			status = "okay";
		};
	};

	rpm-regulator-smpa7 {
		status = "okay";
		S7A: pm8150_s7: regulator-s7a-e0 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1200000>;
			qcom,init-voltage = <1128000>;
			status = "okay";
		};
	};

	rpm-regulator-smpa8 {
		status = "okay";
		S8A: pm8150_s8: regulator-s8a-e0 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
			qcom,init-voltage = <624000>;
			status = "okay";
		};
	};

	/* PM8150 S9A - VDD_MX supply */
	rpm-regulator-smpa9 {
		status = "okay";
		qcom,resource-name = "rwmx";
		qcom,resource-id = <0>;

		VDD_MX_LEVEL:
