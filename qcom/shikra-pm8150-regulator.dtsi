			qcom,use-voltage-level;
		};

		VDD_MX_FLOOR_LEVEL:
		S9A_FLOOR_LEVEL:
		pm8150_s9_floor_level: regulator-s9-floor-level {
			compatible = "qcom,rpm-smd-regulator";
