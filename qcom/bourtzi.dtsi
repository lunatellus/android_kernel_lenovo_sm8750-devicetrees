	cnoc3: interconnect@1510000 {
		reg = <0x0 0x01510000 0x0 0xF200>;
		compatible = "qcom,ravelin-cnoc3";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
