			<&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>;
	};

	cnoc2: interconnect@1500000 {
		reg = <0x0 0x1500000 0x0 0x6200>;
		compatible = "qcom,ravelin-cnoc2";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
