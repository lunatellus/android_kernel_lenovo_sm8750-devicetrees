	};

	pcie_anoc: interconnect@16C0000 {
		reg = <0x0 0x16C0000 0x0 0x7080>;
		compatible = "qcom,ravelin-pcie_anoc";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
