	gcc_vcodec0_gdsc: qcom,gdsc@1b6044 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x1b6044 0x0 0x4>;
		regulator-name = "gcc_vcodec0_gdsc";
		qcom,retain-regs;
		qcom,support-hw-trigger;
		parent-supply = <&VDD_CX_LEVEL>;
		status = "ok";
	};

	hlos1_vote_mmnoc_mmu_tbu_hf0_gdsc: qcom,gdsc@18d050 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x18d050 0x0 0x4>;
		regulator-name = "hlos1_vote_mmnoc_mmu_tbu_hf0_gdsc";
		qcom,no-status-check-on-disable;
		parent-supply = <&VDD_CX_LEVEL>;
		status = "ok";
	};

	hlos1_vote_mmnoc_mmu_tbu_hf1_gdsc: qcom,gdsc@18d058 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x18d058 0x0 0x4>;
		regulator-name = "hlos1_vote_mmnoc_mmu_tbu_hf1_gdsc";
		qcom,no-status-check-on-disable;
		parent-supply = <&VDD_CX_LEVEL>;
		status = "ok";
	};

	hlos1_vote_mmnoc_mmu_tbu_sf0_gdsc: qcom,gdsc@18d054 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x18d054 0x0 0x4>;
		regulator-name = "hlos1_vote_mmnoc_mmu_tbu_sf0_gdsc";
		qcom,no-status-check-on-disable;
		parent-supply = <&VDD_CX_LEVEL>;
		status = "ok";
	};

	/* GPU_CC GDSCs */
	gpu_cc_cx_hw_ctrl: syscon@3d991b4 {
		compatible = "syscon";
		reg = <0x0 0x3d991b4 0x0 0x4>;
	};

	/* GPU_CC GDSCs */
	gpu_cc_cx_gdsc: qcom,gdsc@3d990d0 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x3d990d0 0x0 0x4>;
		hw-ctrl-addr = <&gpu_cc_cx_hw_ctrl>;
		regulator-name = "gpu_cc_cx_gdsc";
		qcom,no-status-check-on-disable;
		qcom,clk-dis-wait-val = <8>;
		qcom,retain-regs;
		clocks = <&gcc GCC_GPU_CFG_AHB_CLK>;
		clock-names = "ahb_clk";
		parent-supply = <&VDD_CX_LEVEL>;
		status = "ok";
	};

	gpu_cc_gx_domain_addr: syscon@3d9917c {
		compatible = "syscon";
		reg = <0x0 0x3d9917c 0x0 0x4>;
	};

	gpu_cc_gx_sw_reset: syscon@3d99050 {
		compatible = "syscon";
		reg = <0x0 0x3d99050 0x0 0x4>;
	};

	gpu_cc_gx_gdsc: qcom,gdsc@3d99054 {
		compatible = "qcom,gdsc";
		reg = <0x0 0x3d99054 0x0 0x4>;
		regulator-name = "gpu_cc_gx_gdsc";
		domain-addr = <&gpu_cc_gx_domain_addr>;
		sw-reset = <&gpu_cc_gx_sw_reset>;
		qcom,reset-aon-logic;
		qcom,retain-regs;
		clocks = <&gcc GCC_GPU_CFG_AHB_CLK>;
		clock-names = "ahb_clk";
		parent-supply = <&VDD_GFX_LEVEL>;
		status = "ok";
	};

	cpufreq_hw: qcom,cpufreq-hw {
		compatible = "qcom,cpufreq-epss";
		reg = <0x0 0x17d91000 0x0 0x1000>, <0x0 0x17d92000 0x0 0x1000>;
		reg-names = "freq-domain0", "freq-domain1";
		clocks = <&rpmhcc RPMH_CXO_CLK>, <&gcc GCC_GPLL0>;
		clock-names = "xo", "alternate";
		interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dcvsh0_int", "dcvsh1_int";
		#freq-domain-cells = <1>;
	};

	qcom,cpufreq-hw-debug {
		compatible = "qcom,cpufreq-hw-epss-debug";
		qcom,freq-hw-domain = <&cpufreq_hw 0>, <&cpufreq_hw 1>;
	};

	clk_virt: interconnect@0 {
		compatible = "qcom,ravelin-clk_virt";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	mc_virt: interconnect@1 {
		compatible = "qcom,ravelin-mc_virt";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos", "disp";
		qcom,bcm-voters = <&apps_bcm_voter>, <&disp_bcm_voter>;
	};

	aggre1_noc: interconnect@16e0000 {
		reg = <0x0 0x16E0000 0x0 0x13080>;
		compatible = "qcom,ravelin-aggre1_noc";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
		clocks = <&gcc GCC_SDCC2_AHB_CLK>;
