/* stock fragment@1 */
&thermal_zones {

	pm8010m_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8010m_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "hot";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};

	pm8010n_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8010n_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "hot";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};
};

