&soc {

	sys_temp_support {
		compatible = "lenovo,sys-temp";
		lenovo,temperature-names = "front_temp", "back_temp", "user_temp", "user_front_temp", "user_back_temp";
		lenovo,sensor-listener-names = "fcam-ntc", "quiet-therm", "usb2-conn-therm", "flash-led-ntc", "batt-pack-therm", "batt2-pack-therm", "ap-therm", "lcm-thermal";
		cust,all-ntc-names = "ap-therm", "flash-led-ntc", "wlan-therm", "usb2-conn-therm", "rear-cam-ntc", "xo-therm", "quiet-therm", "fast-chg-therm", "ufs-therm", "fcam-ntc", "top-chg-therm", "batt2-pack-therm", "batt-pack-therm", "usb1-conn-therm", "lcm-thermal";
	};
};

/* stock fragment@36 */
&thermal_zones {

	ap-therm {
		polling-delay-passive = <0x0>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x144>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};
	};

	flash-led-ntc {
		polling-delay-passive = <0x0>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x145>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};
	};

	wlan-therm {
		polling-delay-passive = <0x0>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x146>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};
	};

	usb2-conn-therm {
		polling-delay-passive = <0x0>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x147>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};
	};

	rear-cam-ntc {
		polling-delay-passive = <0x0>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x148>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};
	};

	xo-therm {
		polling-delay-passive = <0x1388>;
		polling-delay = <0x0>;
		thermal-sensors = <&pmk8550_vadc 0x14d>;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			trip_config0_cust: trip-config0 {
				temperature = <0x130b0>;
				hysteresis = <0x1f40>;
				type = "passive";
			};

			trip_config1_cust: trip-config1 {
				temperature = <0x13880>;
				hysteresis = <0x2710>;
				type = "passive";
			};

			shutdown-trip_cust {
				temperature = <0x15f90>;
				hysteresis = <0x0>;
				type = "hot";
			};

			display_test_config1_cust: display-test-config1 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			display_test_config2_cust: display-test-config2 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};

			display_test_config3_cust: display-test-config3 {
				temperature = <0x1e848>;
				hysteresis = <0x3e8>;
				type = "passive";
			};
		};

		cooling-maps {

			apc1_cdev {
				trip = <&trip_config0_cust>;
				cooling-device = <&APC1_MX_CX_PAUSE 0x1 0x1>;
			};

			apc0_cdev {
				trip = <&trip_config0_cust>;
				cooling-device = <&APC0_MX_CX_PAUSE 0x1 0x1>;
			};

			cdsp_cdev {
				trip = <&trip_config0_cust>;
				cooling-device = <&cdsp_sw 0x5 0xffffffff>;
			};

			gpu_cdev {
				trip = <&trip_config0_cust>;
				cooling-device = <&msm_gpu 0x5 0xffffffff>;
			};

			cpu3_hot_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&cpu3_hotplug 0x1 0x1>;
			};

			cpu4_hot_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&cpu4_hotplug 0x1 0x1>;
			};

			cpu5_hot_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&cpu5_hotplug 0x1 0x1>;
			};

			cpu6_hot_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&cpu6_hotplug 0x1 0x1>;
			};

			cpu7_hot_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&cpu7_hotplug 0x1 0x1>;
			};

			lte_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&modem_lte_dsc 0xff 0xff>;
			};

			nr_cdev {
				trip = <&trip_config1_cust>;
				cooling-device = <&modem_nr_scg_dsc 0xff 0xff>;
			};

			display_cdev1 {
				trip = <&display_test_config1_cust>;
				cooling-device = <&display_fps 0x1 0x1>;
			};

			display_cdev2 {
				trip = <&display_test_config2_cust>;
				cooling-device = <&display_fps 0x2 0x2>;
			};

			display_cdev3 {
				trip = <&display_test_config3_cust>;
				cooling-device = <&display_fps 0x3 0x3>;
			};
		};
	};

