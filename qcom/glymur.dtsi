			#interconnect-cells = <1>;
			clocks = <&gcc GCC_AGGRE_NOC_PCIE_5_EAST_SF_AXI_CLK>;
		};

		aggre1_noc: interconnect@16e0000 {
			compatible = "qcom,glymur-aggre1_noc";
			reg = <0x0 0x016e0000 0x0 0x14400>;
			qcom,bcm-voter-names = "hlos";
