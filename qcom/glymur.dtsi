		qfprom: qfprom@361c8000 {
			compatible = "qcom,glymur-qfprom", "qcom,qfprom";
			reg = <0x0 0x361c8000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			read-only;

			gpu_speed_bin: gpu_speed_bin@138 {
				reg = <0x138 0x2>;
				bits = <0 9>;
				};

		};

		imem: sram@81e08600 {
			compatible = "mmio-sram";
			reg = <0x0 0x81e08600 0x0 0x300>;

			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x81e08600 0x300>;

			cpu_scp_lpri0: scp-sram-section@0 {
				compatible = "arm,scmi-shmem";
				reg = <0x0 0x180>;
			};

			cpu_scp_lpri1: scp-sram-section@180 {
				compatible = "arm,scmi-shmem";
				reg = <0x180 0x180>;
			};
		};

		qcom,mem-buf {
			compatible = "qcom,mem-buf";
			qcom,mem-buf-capabilities = "supplier";
			qcom,vmid = <3>;
		};

		qcom,mem-buf-msgq {
			compatible = "qcom,mem-buf-msgq";
			qcom,msgq-names = "trusted_vm", "oem_vm";
		};

		qcom,secure-buffer {
			compatible = "qcom,secure-buffer";
			qcom,vmid-cp-camera-preview-ro;
		};
	};

	msm_gpu: qcom,kgsl-3d0@3d00000 { };

	arch_timer: timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
	};
};

#include "glymur-pinctrl.dtsi"
#include "mahua-regulators.dtsi"
#include "msm-arm-smmu-glymur.dtsi"
#include "mahua-qupv3.dtsi"
#include "glymur-pcie.dtsi"

&qupv3_se21_2uart {
	status = "okay";
};
