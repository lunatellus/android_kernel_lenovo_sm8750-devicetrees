		bwmon_llcc_cluster0: qcom,bwmon-llcc-gold@0x0100C300 {
			compatible = "qcom,bwmon4";
			reg = <0x0 0x0100C400 0x0 0x300>, <0x0 0x0100C300 0x0 0x200>;
			reg-names = "base", "global_base";
			interrupts = <GIC_SPI 581 IRQ_TYPE_LEVEL_HIGH>;
			qcom,mport = <0>;
			qcom,hw-timer-hz = <19200000>;
			qcom,count-unit = <0x10000>;
			qcom,target-dev = <&qcom_llcc_dcvs_hw>;
			qcom,second-vote = <&qcom_llcc_ddr_vote>;
		};

		bwmon_llcc_cluster1: qcom,bwmon-llcc-prime@0x0100D300 {
			compatible = "qcom,bwmon4";
			reg = <0x0  0x0100D400 0x0 0x300>, <0x0 0x0100D300 0x0 0x200>;
			reg-names = "base", "global_base";
			interrupts = <GIC_SPI 581 IRQ_TYPE_LEVEL_HIGH>;
			qcom,mport = <0>;
			qcom,hw-timer-hz = <19200000>;
			qcom,count-unit = <0x10000>;
			qcom,target-dev = <&qcom_llcc_dcvs_hw>;
			qcom,second-vote = <&qcom_llcc_ddr_vote>;
		};

		bwmon_llcc_cluster2: qcom,bwmon-llcc-prime@0x0100E300 {
			compatible = "qcom,bwmon4";
			reg = <0x0  0x0100E400 0x0 0x300>, <0x0 0x0100E300 0x0 0x200>;
			reg-names = "base", "global_base";
			interrupts = <GIC_SPI 581 IRQ_TYPE_LEVEL_HIGH>;
			qcom,mport = <0>;
			qcom,hw-timer-hz = <19200000>;
			qcom,count-unit = <0x10000>;
			qcom,target-dev = <&qcom_llcc_dcvs_hw>;
			qcom,second-vote = <&qcom_llcc_ddr_vote>;
		};

		bwmon_ddr: qcom,bwmon-ddr@20091000 {
			compatible = "qcom,bwmon5";
			reg = <0x0 0x20091000 0x0 0x1000>;
			reg-names = "base";
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			qcom,hw-timer-hz = <19200000>;
			qcom,count-unit = <0x10000>;
			qcom,target-dev = <&qcom_ddr_dcvs_hw>;
		};

		qcom,smp2p-cdsp {
			compatible = "qcom,smp2p";
			qcom,smem = <94>, <432>;
			interrupt-parent = <&ipcc_mproc>;
			interrupts = <IPCC_CLIENT_CDSP
				      IPCC_MPROC_SIGNAL_SMP2P
				      IRQ_TYPE_EDGE_RISING>;
			mboxes = <&ipcc_mproc IPCC_CLIENT_CDSP IPCC_MPROC_SIGNAL_SMP2P>;
			qcom,local-pid = <0>;
			qcom,remote-pid = <5>;

			cdsp_smp2p_out: master-kernel {
				qcom,entry-name = "master-kernel";
				#qcom,smem-state-cells = <1>;
			};

			cdsp_smp2p_in: slave-kernel {
				qcom,entry-name = "slave-kernel";
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			smp2p_test5_in: qcom,smp2p-test5-in {
				qcom,entry-name = "smp2p";
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			smp2p_test5_out: qcom,smp2p-test5-out {
				qcom,entry-name = "smp2p";
				#qcom,smem-state-cells = <1>;
			};
		};

		qcom,smp2p-adsp {
			compatible = "qcom,smp2p";
			qcom,smem = <443>, <429>;
			interrupt-parent = <&ipcc_mproc>;
			interrupts = <IPCC_CLIENT_LPASS
				      IPCC_MPROC_SIGNAL_SMP2P
				      IRQ_TYPE_EDGE_RISING>;
			mboxes = <&ipcc_mproc IPCC_CLIENT_LPASS IPCC_MPROC_SIGNAL_SMP2P>;
			qcom,local-pid = <0>;
			qcom,remote-pid = <2>;

			adsp_smp2p_out: master-kernel {
				qcom,entry-name = "master-kernel";
				#qcom,smem-state-cells = <1>;
			};

			adsp_smp2p_in: slave-kernel {
				qcom,entry-name = "slave-kernel";
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			sleepstate_smp2p_out: sleepstate-out {
				qcom,entry-name = "sleepstate";
				#qcom,smem-state-cells = <1>;
			};

			sleepstate_smp2p_in: qcom,sleepstate-in {
				qcom,entry-name = "sleepstate_see";
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			smp2p_test2_in: qcom,smp2p-test2-in {
				qcom,entry-name = "smp2p";
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			smp2p_test2_out: qcom,smp2p-test2-out {
				qcom,entry-name = "smp2p";
				#qcom,smem-state-cells = <1>;
			};
		};

		qcom,smp2p_sleepstate {
			compatible = "qcom,smp2p-sleepstate";
			qcom,smem-states = <&sleepstate_smp2p_out 0>;
			interrupt-parent = <&sleepstate_smp2p_in>;
			interrupts = <0 0>;
			interrupt-names = "smp2p-sleepstate-in";
		};

		qcom,smp2p_test_adsp {
			compatible = "qcom,smp2p-test";
			label = "adsp";
			qcom,smem-states = <&smp2p_test2_out 0>;
			interrupts-extended = <&smp2p_test2_in 0 0>;
		};

		qcom,smp2p-soccp {
			compatible = "qcom,smp2p";
			qcom,smem = <617>, <616>;
			interrupt-parent = <&ipcc_mproc>;
			interrupts = <IPCC_CLIENT_SOCCP
				      IPCC_MPROC_SIGNAL_SMP2P
				      IRQ_TYPE_EDGE_RISING>;
			mboxes = <&ipcc_mproc IPCC_CLIENT_SOCCP IPCC_MPROC_SIGNAL_SMP2P>;
			qcom,local-pid = <0>;
			qcom,remote-pid = <19>;

			soccp_smp2p_out: master-kernel {
				qcom,entry-name = "master-kernel";
				#qcom,smem-state-cells = <1>;
			};

			soccp_smp2p_in: slave-kernel {
				qcom,entry-name = "slave-kernel";
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};

		pdc: interrupt-controller@b220000 {
			compatible = "qcom,glymur-pdc", "qcom,pdc";
			reg = <0x0 0x0b220000 0x0 0x10000>;

			qcom,pdc-ranges = <0 745 51>,
					  <51 527 47>,
					  <98 609 32>,
					  <130 717 12>,
					  <142 251 5>,
					  <147 796 16>,
					  <171 4104 36>;

			#interrupt-cells = <2>;
			interrupt-parent = <&intc>;
			interrupt-controller;
		};

		qspi: qspi@88dc000 {
			compatible = "qcom,qspi-v1";
			reg = <0x0 0x088dc000 0x0 0x1000>;
			iommus = <&apps_smmu 0xd20 0x0>;
			qcom,iommu-dma = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_QSPI_CNOC_PERIPH_AHB_CLK>,
				<&gcc GCC_QSPI_CORE_CLK>;
			clock-names = "iface", "core";
			interconnects = <&aggre3_noc MASTER_QSPI_0 &mc_virt SLAVE_EBI1>,
					<&hsc_noc MASTER_APPSS_PROC &config_noc SLAVE_QSPI_0>;
			interconnect-names = "qspi-memory", "qspi-config";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&qspi_clk>, <&qspi_cs0>, <&qspi_data>;
			pinctrl-1 = <&qspi_sleep>;
			status = "disabled";
		};

	pmic-glink {
		compatible = "qcom,qti-pmic-glink";
		qcom,pmic-glink-channel = "PMIC_RTR_SOCCP_APPS";
		depends-on-supply = <&ipcc_mproc>;
		qcom,subsys-name = "soccp";

		battery_charger: battery-charger {
			compatible = "qcom,canoe-battery-charger";
		};

		ucsi: ucsi-glink {
			compatible = "qcom,ucsi-glink";
		};

		altmode: altmode-glink {
			compatible = "qcom,altmode-glink";
			#altmode-cells = <1>;
		};
	};

	pmic-glink-log {
		compatible = "qcom,qti-pmic-glink";
		qcom,pmic-glink-channel = "PMIC_LOGS_SOCCP_APPS";

		battery-debug {
			compatible = "qcom,battery-debug";
		};

		charger-ulog-glink {
			compatible = "qcom,charger-ulog-glink";
		};

		pmic_glink_debug: pmic-glink-debug {
			compatible = "qcom,pmic-glink-debug";
			#address-cells = <1>;
			#size-cells = <0>;
			depends-on-supply = <&spmi1_bus>;

			spmi@1 {
				reg = <1>;
				#address-cells = <2>;
				#size-cells = <0>;
			};
		};

		pmic_glink_adc: glink-adc {
			compatible = "qcom,glink-adc";
			#address-cells = <1>;
			#size-cells = <0>;
			#io-channel-cells = <1>;
			status = "disabled";
		};
	};

		adsp_pas: remoteproc-adsp@6800000 {
			compatible = "qcom,glymur-adsp-pas";
			reg = <0x0 0x06800000 0x0 0x10000>;

			cx-supply = <&VDD_LPI_CX_LEVEL>;
			cx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 0>;
			mx-supply = <&VDD_LPI_MX_LEVEL>;
			mx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 0>;
			reg-names = "cx", "mx";

			interrupts-extended = <&intc GIC_SPI 751 IRQ_TYPE_EDGE_RISING>,
						<&adsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
						<&adsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
						<&adsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
						<&adsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;

			interrupt-names = "wdog",
					"fatal",
					"ready",
					"handover",
					"stop-ack";

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";

			interconnects = <&lpass_lpicx_noc MASTER_LPASS_PROC &mc_virt SLAVE_EBI1>,
					<&aggre1_noc MASTER_CRYPTO &mc_virt SLAVE_EBI1>;
			interconnect-names = "rproc_ddr", "crypto_ddr";

			firmware-name = "adsp.mdt", "adsp_dtb.mdt";
			memory-region = <&adspslpi_mem>,
					<&q6_adsp_dtb_mem>;

			qcom,qmp = <&aoss_qmp>;

			qcom,smem-states = <&adsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";

			status = "okay";

			remoteproc_adsp_glink: glink-edge {
				qcom,remote-pid = <2>;
				transport = "smem";
				mboxes = <&ipcc_mproc IPCC_CLIENT_LPASS
					  IPCC_MPROC_SIGNAL_GLINK_QMP>;
				mbox-names = "adsp_smem";
				interrupt-parent = <&ipcc_mproc>;
				interrupts = <IPCC_CLIENT_LPASS
					      IPCC_MPROC_SIGNAL_GLINK_QMP
					      IRQ_TYPE_EDGE_RISING>;

				label = "adsp";
				qcom,glink-label = "lpass";

				qcom,adsp_qrtr {
					qcom,glink-channels = "IPCRTR";
					qcom,intents = <0x800  5
							0x2000 3
							0x4400 2>;

					qcom,no-wake-svc = <0x190>;
				};
			};
		};

		cdsp_pas: remoteproc-cdsp@32300000 {
			compatible = "qcom,glymur-cdsp-pas";
			reg = <0x0 0x32300000 0x0 0x10000>;

			cx-supply = <&VDD_CX_LEVEL>;
			cx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			mx-supply = <&VDD_MXC_LEVEL>;
			mx-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			nsp-supply = <&VDD_NSP1_LEVEL>;
			nsp-uV-uA = <RPMH_REGULATOR_LEVEL_TURBO 100000>;
			reg-names = "cx","mx","nsp";

			interrupts-extended = <&intc GIC_SPI 578 IRQ_TYPE_EDGE_RISING>,
						<&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
						<&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
						<&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
						<&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;

			interrupt-names = "wdog",
					"fatal",
					"ready",
					"handover",
					"stop-ack";

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "xo";

			interconnects = <&nsp_noc MASTER_CDSP_PROC &mc_virt SLAVE_EBI1>,
					<&aggre1_noc MASTER_CRYPTO &mc_virt SLAVE_EBI1>;
			interconnect-names = "rproc_ddr", "crypto_ddr";

			firmware-name = "cdsp.mdt", "cdsp_dtb.mdt";
			memory-region = <&cdsp_mem>,
					<&q6_cdsp_dtb_mem>;

			qcom,qmp = <&aoss_qmp>;

			qcom,smem-states = <&cdsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";

			status = "okay";

			remoteproc_cdsp_glink: glink-edge {
				qcom,remote-pid = <5>;
				transport = "smem";
				mboxes = <&ipcc_mproc IPCC_CLIENT_CDSP
					  IPCC_MPROC_SIGNAL_GLINK_QMP>;
				mbox-names = "cdsp_smem";
				interrupt-parent = <&ipcc_mproc>;
				interrupts = <IPCC_CLIENT_CDSP
					      IPCC_MPROC_SIGNAL_GLINK_QMP
					      IRQ_TYPE_EDGE_RISING>;

				label = "cdsp";
				qcom,glink-label = "cdsp";

				qcom,cdsp_qrtr {
					qcom,glink-channels = "IPCRTR";
					qcom,intents = <0x800  5
							0x2000 3
							0x4400 2>;
				};
			};
		};

		intc: interrupt-controller@17000000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x17000000 0x0 0x10000>,
			      <0x0 0x17080000 0x0 0x480000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			#interrupt-cells = <3>;
			interrupt-controller;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			gic_its: msi-controller@17040000 {
				compatible = "arm,gic-v3-its";
				reg = <0x0 0x17040000 0x0 0x40000>;
				msi-controller;
				#msi-cells = <1>;
			};
		};

		timer@17810000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0x0 0x17810000 0x0 0x1000>;
			#address-cells = <2>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x0 0x0 0x20000000>;

			frame@17811000 {
				reg = <0x0 0x17811000 0x1000>,
				      <0x0 0x17812000 0x1000>;
				interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <0>;
			};

			frame@17813000 {
				reg = <0x0 0x17813000 0x1000>;
				interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <1>;
				status = "disabled";
			};

			frame@17815000 {
				reg = <0x0 0x17815000 0x1000>;
				interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <2>;
				status = "disabled";
			};

			frame@17817000 {
				reg = <0x0 0x17817000 0x1000>;
				interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <3>;
				status = "disabled";
			};

			frame@17819000 {
				reg = <0x0 0x17819000 0x1000>;
				interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <4>;
				status = "disabled";
			};

			frame@1781b000 {
				reg = <0x0 0x1781b000 0x1000>;
				interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <5>;
				status = "disabled";
			};

			frame@1781d000 {
				reg = <0x0 0x1781d000 0x1000>;
				interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <6>;
				status = "disabled";
			};
		};

		qcom,msm-adsprpc-mem {
			compatible = "qcom,msm-adsprpc-mem-region";
			memory-region = <&adsp_mem_heap>;
			restrict-access;
		};

		cpucp: qcom,cpucp@18830000 {
			compatible = "qcom,cpucp-v2";
			reg = <0x0 0x17620000 0x0 0x10000>,
				<0x0 0x18830000 0x0 0x10000>;
			reg-names = "rx", "tx";
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			#mbox-cells = <1>;
		};

		cpucp_log: qcom,cpucp_log@0x80e10000 {
			compatible = "qcom,cpucp-log";
			reg =	<0x0 0x80e10000 0x0 0x10000>,
				<0x0 0x80e20000 0x0 0x10000>;
			mboxes = <&cpucp 1>;
			qcom,log-type = <0>;
		};

		pdp0: qcom,pdp0@0x19980000 {
			compatible = "qcom,cpucp-v2";
			reg =	<0x0 0x19980000 0x0 0x8000>,
				<0x0 0x17610000 0x0 0x8000>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
			qcom,rx-chans = <0x0B>;
		};

		pdp1: qcom,pdp1@0x1a980000 {
			compatible = "qcom,cpucp-v2";
			reg =	<0x0 0x1a980000 0x0 0x300>,
				<0x0 0x17610000 0x0 0x4C08>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
			qcom,rx-chans = <0x10>;
		};

		pdp2: qcom,pdp2@0x1b980000 {
			compatible = "qcom,cpucp-v2";
			reg =	<0x0 0x1b980000 0x0 0x300>,
				<0x0 0x17610000 0x0 0x4C08>;
			reg-names = "tx", "rx";
			#mbox-cells = <1>;
			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
			qcom,rx-chans = <0x20>;
		};

		pdp0_log: qcom,pdp0_log@0x81e4a000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x81e4a000 0x0 0x20000>,
				<0x0 0x81e6a000 0x0 0x20000>;
			mboxes = <&pdp0 3>, <&pdp0 2>;
			qcom,log-type = <1>;
		};

		pdp1_log: qcom,pdp1_log@0x81e8a000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x81e8a000 0x0 0x20000>,
				<0x0 0x81eaa000 0x0 0x20000>;
			mboxes = <&pdp1 4>, <&pdp1 2>;
			qcom,log-type = <2>;
		};

		pdp2_log: qcom,pdp2_log@0x81eca000 {
			compatible = "qcom,pdp-log";
			reg =	<0x0 0x81eca000 0x0 0x20000>,
				<0x0 0x81eea000 0x0 0x20000>;
			mboxes = <&pdp2 5>, <&pdp2 2>;
			qcom,log-type = <3>;
		};

		apps_rsc: rsc@18900000 {
			label = "apps_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0x0 0x18900000 0x0 0x10000>,
			      <0x0 0x18910000 0x0 0x10000>,
			      <0x0 0x18920000 0x0 0x10000>;
			reg-names = "drv-0", "drv-1", "drv-2";
			qcom,drv-count = <3>;
			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&system_pd>;

			apps_rsc_drv2: drv@2 {
				qcom,drv-id = <2>;
				qcom,tcs-offset = <0xd00>;
				qcom,tcs-distance = <0x2a0>;
				channel@0 {
					qcom,tcs-config = <ACTIVE_TCS    2>,
							  <SLEEP_TCS     3>,
							  <WAKE_TCS      3>,
							  <CONTROL_TCS   0>,
							  <FAST_PATH_TCS 0>;
				};

				rpmhcc: clock-controller {
					compatible = "qcom,glymur-rpmh-clk";
					clocks = <&xo_board>;
					clock-names = "xo";
					#clock-cells = <1>;
				};

				apps_bcm_voter: bcm_voter {
					compatible = "qcom,bcm-voter";
				};

			};
		};

		qcom,qrtr-mhi-cnss {
			compatible = "qcom,qrtr-mhi";
			qcom,dev-id = <0x1103>;
			qcom,net-id = <0>;
			qcom,low-latency;
		};

		qcom,qrtr-mhi-cnss1 {
			compatible = "qcom,qrtr-mhi";
			qcom,dev-id = <0x1107>;
			qcom,net-id = <1>;
			qcom,low-latency;
		};

		disp_rsc: rsc@af20000 {
			label = "disp_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0x0 0xaf20000 0x0 0x10000>;
			reg-names = "drv-0";
			qcom,drv-count = <1>;
			interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dispcc DISP_CC_MDSS_RSCC_AHB_CLK>;

			disp_rsc_drv0: drv@0 {
				qcom,drv-id = <0>;
				qcom,tcs-offset = <0x1c00>;
				qcom,tcs-distance = <0x2a0>;
				channel@0 {
					qcom,tcs-config = <ACTIVE_TCS    0>,
							  <SLEEP_TCS     1>,
							  <WAKE_TCS      1>,
							  <CONTROL_TCS   0>,
							  <FAST_PATH_TCS 0>;
				};
			};
		};

		cluster_device0: cluster-device0 {
			compatible = "qcom,lpm-cluster-dev";
			power-domains = <&cluster0_pd>;
			qcom,pred-prem-cnt = <2>;
			qcom,sample-invalid-time = <40000000>;
		};

		cluster_device1: cluster-device1 {
			compatible = "qcom,lpm-cluster-dev";
			power-domains = <&cluster1_pd>;
			qcom,pred-prem-cnt = <2>;
			qcom,sample-invalid-time = <40000000>;
		};

		cluster_device2: cluster-device2 {
			compatible = "qcom,lpm-cluster-dev";
			power-domains = <&cluster2_pd>;
			qcom,pred-prem-cnt = <2>;
			qcom,sample-invalid-time = <40000000>;
		};

		cluster_device3: cluster-device3 {
			compatible = "qcom,lpm-cluster-dev";
			power-domains = <&system_pd>;
			qcom,pred-prem-cnt = <2>;
			qcom,sample-invalid-time = <40000000>;
		};

		sram@c3f0000 {
			compatible = "qcom,rpmh-stats-v4";
			reg = <0x0 0x0c30f000 0x0 0x400>;
			qcom,qmp = <&aoss_qmp>;
			ss-name = "adsp", "adsp_island", "cdsp", "apss";
		};

		cpuss_sleep_stats: cpuss-sleep-stats {
			compatible = "qcom,cpuss-sleep-stats-v6", "qcom,cpuss-sleep-stats-glymur";
			num-clusters = <3>;
		};

		sys-pm-vx@c320000 {
			compatible = "qcom,sys-pm-violators-v2";
			reg = <0x0 0x0c302000 0x0 0x400>, <0x0 0xc305000 0x0 0x400>;
			qcom,qmp = <&aoss_qmp>;
		};

		usb_ss0: ssusb@a600000 {
			compatible = "qcom,dwc-usb3-msm";
			reg = <0x0 0xa600000 0x0 0x100000>;
			reg-names = "core_base";

			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			clocks = <&gcc GCC_USB30_PRIM_MASTER_CLK>,
				<&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
				<&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>,
				<&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>,
				<&gcc GCC_USB30_PRIM_SLEEP_CLK>,
				<&gcc GCC_USB30_PRIM_ATB_CLK>,
				<&gcc GCC_CFG_NOC_USB_ANOC_AHB_CLK>,
				<&gcc GCC_CFG_NOC_USB_ANOC_SOUTH_AHB_CLK>;
			clock-names = "core_clk",
				"iface_clk",
				"bus_aggr_clk",
				"utmi_clk",
				"sleep_clk",
				"atb_clk",
				"cfg_noc_clk",
				"noc_aggr_south_ahb_clk";

			interrupts-extended = <&intc GIC_SPI 371 IRQ_TYPE_LEVEL_HIGH>,
				<&pdc 90 IRQ_TYPE_EDGE_BOTH>,
				<&pdc 60 IRQ_TYPE_EDGE_BOTH>,
				<&pdc 17 IRQ_TYPE_LEVEL_HIGH>;

			interrupt-names = "pwr_event_irq",
				"dp_hs_phy_irq",
				"dm_hs_phy_irq",
				"ss_phy_irq";

			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
			resets = <&gcc GCC_USB30_PRIM_BCR>;
			reset-names = "core_reset";

			qcom,use-pdc-interrupts;
			qcom,use-eusb2-phy;
			qcom,host-poweroff-in-pm-suspend;
			qcom,default-mode-host;

			qcom,dis-sending-cm-l1-quirk;
			qcom,core-clk-rate = <200000000>;
			qcom,core-clk-rate-hs = <66666667>;
			qcom,core-clk-rate-disconnected = <133333333>;

			interconnects = <&aggre4_noc MASTER_USB3_0 0 &mc_virt SLAVE_EBI1 0>,
					<&hsc_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_USB3_0 0>;
			interconnect-names = "usb-ddr",
					"ddr-usb";

			/*
			 * Establish dependency on smmu driver so that depopulate path of
			 * deferred probe doesn't run into existing bug in smmu driver.
			 */
			dummy-supply = <&apps_smmu>;

			dwc3_0: dwc3@a600000 {
				compatible = "snps,dwc3";
				reg = <0x0 0xa600000 0x0 0xe000>;

				iommus = <&apps_smmu 0x1420 0x0>;
				qcom,iommu-dma = "atomic";
				memory-region = <&dwc3_0_mem_region>;
				dma-coherent;

				interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
				phys = <&usb2_phy_0>, <&usb3_phy_0 QMP_USB43DP_USB3_PHY>;
				phy-names = "usb2-phy", "usb3-phy";
				snps,disable-clk-gating;
				snps,has-lpm-erratum;
				snps,hird-threshold = /bits/ 8 <0x0>;
				snps,is-utmi-l1-suspend;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				snps,dis_u2_susphy_quirk;
				snps,ssp-u3-u0-quirk;
				tx-fifo-resize;
				num-hc-interrupters = /bits/ 16 <3>;
				xhci-skip-phy-init-quirk;
				dr_mode = "otg";
				maximum-speed = "super-speed-plus";
				usb-role-switch;
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usb_ss0_dwc3_hs: endpoint {
					};
				};

				port@1 {
					reg = <1>;

					usb_ss0_dwc3_ss: endpoint {
						remote-endpoint = <&usb_ss0_qmpphy_in>;
					};
				};
			};
		};

		dwc3_0_mem_region: dwc3_0_mem_region {
			iommu-addresses = <&dwc3_0 0x0 0x0 0x0 0x90000000>,
					<&dwc3_0 0x0 0xf0000000 0xffffffff 0x10000000>;
		};

		usb2_phy_0: phy@fd3000 {
			compatible = "qcom,glymur-m31-eusb2-phy",
				     "qcom,m31-eusb2-phy";

			reg = <0x0 0xfd3000 0x0 0x29c>,
				<0x0 0xfd2000 0x0 0x4>,
				<0x0 0xc278000 0x0 0x4>;
			reg-names = "eusb2_phy_base",
				"eud_enable_reg",
				"eud_detect_reg";

			#phy-cells = <0>;

			vdd-supply = <&L3F_E0>;
			qcom,vdd-voltage-level = <0 880000 880000>;
			vdda12-supply = <&L4H_E0>;
			vdd_refgen-supply = <&L2F_E0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-names = "ref_clk_src";

			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
			reset-names = "phy_reset";

			status = "disabled";
		};

		usb3_phy_0: phy@fd5000 {
			compatible = "qcom,glymur-qmp-usb3-dp-phy";
			reg = <0x0 0x00fd5000 0x0 0x8000>;
			reg-names = "qmp_phy_base";

			clocks = <&gcc GCC_USB3_PRIM_PHY_AUX_CLK>,
				 <&rpmhcc RPMH_CXO_CLK>,
				 <&gcc GCC_USB3_PRIM_PHY_COM_AUX_CLK>,
				 <&gcc GCC_USB3_PRIM_PHY_PIPE_CLK_SRC>,
				 <&usb3_phy_0_wrapper_gcc_usb30_pipe_clk>,
				 <&gcc GCC_USB3_PRIM_PHY_PIPE_CLK>;
			clock-names = "aux",
				      "ref",
				      "com_aux",
				      "pipe_clk_mux",
				      "pipe_clk_ext_src",
				      "usb3_pipe";

			resets = <&gcc GCC_USB3_PHY_PRIM_BCR>,
				 <&gcc GCC_USB3PHY_PHY_PRIM_BCR>;
			reset-names = "phy",
				      "common";

			power-domains = <&gcc GCC_USB_0_PHY_GDSC>;

			#clock-cells = <1>;
			#phy-cells = <1>;

			vdda-phy-supply = <&L4H_E0>;
			vdda-pll-supply = <&L3F_E0>;
			refgen-supply = <&L2F_E0>;

			orientation-switch;

			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usb_ss0_qmpphy_out: endpoint {
					};
				};

				port@1 {
					reg = <1>;

					usb_ss0_qmpphy_in: endpoint {
						remote-endpoint = <&usb_ss0_dwc3_ss>;
					};
				};
			};
		};

		clk_virt: interconnect@0 {
			compatible = "qcom,glymur-clk_virt";
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
		};

		mc_virt: interconnect@1 {
			compatible = "qcom,glymur-mc_virt";
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
		};

		cnoc_main: interconnect@1500000 {
			compatible = "qcom,glymur-cnoc_main";
			reg = <0x0 0x01500000 0x0 0x17080>;
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
		};

		config_noc: interconnect@1600000 {
			compatible = "qcom,glymur-cnoc_cfg";
			reg = <0x0 0x01600000 0x0 0x6600>;
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
		};

		system_noc: interconnect@1680000 {
			compatible = "qcom,glymur-system_noc";
			reg = <0x0 0x01680000 0x0 0x1c080>;
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
		};

		pcie_west_anoc: interconnect@16c0000 {
			compatible = "qcom,glymur-pcie_west_anoc";
			reg = <0x0 0x016c0000 0x0 0xf580>;
			qcom,bcm-voter-names = "hlos";
			qcom,bcm-voters = <&apps_bcm_voter>;
			#interconnect-cells = <1>;
			clocks = <&gcc GCC_AGGRE_NOC_PCIE_3A_WEST_SF_AXI_CLK>,
				 <&gcc GCC_AGGRE_NOC_PCIE_3B_WEST_SF_AXI_CLK>,
				 <&gcc GCC_AGGRE_NOC_PCIE_4_WEST_SF_AXI_CLK>,
				 <&gcc GCC_AGGRE_NOC_PCIE_6_WEST_SF_AXI_CLK>;
