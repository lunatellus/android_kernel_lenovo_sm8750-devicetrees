						< 2362000  840000 >,
						< 2650000  959000 >,
						< 2938000 1211000 >;
					qcom,cpucp-enabled;
				};

				llcc_cluster1: cluster1 {
					compatible = "qcom,memlat-mon";
					qcom,cpulist = <&cpu6 &cpu7 &cpu8 &cpu9 &cpu10 &cpu11>;
					qcom,cpufreq-memfreq-tbl =
