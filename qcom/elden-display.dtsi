				pins = "gpio98";
			};
		};

		sde_dsi_suspend: sde_dsi_suspend {

			mux {
				function = "gpio";
				pins = "gpio98";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio98";
			};
		};

		sde_dsi1_active: sde_dsi1_active {

			mux {
