		sde_te_suspend: sde_te_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio86";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio86";
			};
		};

		sde_te1_active: sde_te1_active {

			mux {
				function = "mdp_vsync";
				pins = "gpio87";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio87";
			};
		};

		sde_te1_suspend: sde_te1_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio87";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio87";
			};
		};
	};

	pmx_sde_esync: pmx_sde_esync {

		sde_esync0_active: sde_esync0_active {

			mux {
				function = "mdp_esync0_out";
				pins = "gpio88";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio88";
			};
		};

		sde_esync0_suspend: sde_esync0_suspend {

			mux {
				function = "mdp_esync0_out";
				pins = "gpio88";
			};

			config {
				bias-pull-down;
