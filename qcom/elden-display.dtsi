		clocks = <&dispcc 0x8 &dispcc 0x9 &dispcc 0xb &dispcc 0x46 &dispcc 0x47 &dispcc 0x0 &dispcc 0x0 &dispcc 0x3c &rpmhcc 0x0>;
		qcom,split-link-supported;
		vdda-1p2-supply = <&L3G>;
		interrupts = <0x4 0x0>;
		interrupt-parent = <&mdss_mdp>;
		reg-names = "dsi_ctrl", "disp_cc_base", "mdp_intf_base";
		reg = <0xae94000 0x1000 0xaf0f000 0x4 0xae36000 0x300>;
		frame-threshold-time-us = <0x320>;
		cell-index = <0x0>;
		label = "dsi-ctrl-0";
		compatible = "qcom,dsi-ctrl-hw-v2.9";

		qcom,ctrl-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,ctrl-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x40d8>;
				qcom,supply-max-voltage = <0x124f80>;
				qcom,supply-min-voltage = <0x124f80>;
				qcom,supply-name = "vdda-1p2";
				reg = <0x0>;
			};
		};
	};

	mdss_dsi1: qcom,mdss_dsi_ctrl1@ae96000 {
		clock-names = "byte_clk", "byte_clk_rcg", "byte_intf_clk", "pixel_clk", "pixel_clk_rcg", "esync_clk", "osc_clk", "esc_clk", "xo";
		clocks = <&dispcc 0xc &dispcc 0xd &dispcc 0xf &dispcc 0x48 &dispcc 0x49 &dispcc 0x2 &dispcc 0x0 &dispcc 0x3e &rpmhcc 0x0>;
		qcom,split-link-supported;
		vdda-1p2-supply = <&L3G>;
		interrupts = <0x5 0x0>;
		interrupt-parent = <&mdss_mdp>;
		reg-names = "dsi_ctrl", "disp_cc_base", "mdp_intf_base";
		reg = <0xae96000 0x1000 0xaf0f000 0x4 0xae37000 0x300>;
		frame-threshold-time-us = <0x320>;
		cell-index = <0x1>;
		label = "dsi-ctrl-1";
		compatible = "qcom,dsi-ctrl-hw-v2.9";

		qcom,ctrl-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,ctrl-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x40d8>;
				qcom,supply-max-voltage = <0x124f80>;
				qcom,supply-min-voltage = <0x124f80>;
				qcom,supply-name = "vdda-1p2";
				reg = <0x0>;
			};
		};
	};

	mdss_dsi_phy0: qcom,mdss_dsi_phy0@ae95500 {
		pll_codes_region = <&dsi_pll_codes_data>;
		qcom,dsi-pll-ssc-mode = "down-spread";
		qcom,dsi-pll-ssc-en;
		qcom,panel-allow-phy-poweroff;
		vdda-0p9-supply = <&L3I>;
		qcom,platform-regulator-settings = [1d 1d 1d 1d 1d];
		qcom,platform-lane-config = <0xa0a 0xa0a 0xa0a 0xa0a 0x8a8a>;
		qcom,platform-strength-ctrl = [55 03 55 03 55 03 55 03 55 00];
		pll-label = "dsi_pll_3nm";
		reg-names = "dsi_phy", "pll_base", "dyn_refresh_base";
		reg = <0xae95000 0xa00 0xae95500 0x400 0xae94200 0xa0>;
		#clock-cells = <0x1>;
		cell-index = <0x0>;
		label = "dsi-phy-0";
		compatible = "qcom,dsi-phy-v7.2";

		qcom,phy-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,phy-supply-entry@0 {
				qcom,supply-disable-load = <0x60>;
				qcom,supply-enable-load = <0x17ed0>;
				qcom,supply-max-voltage = <0xd6d80>;
				qcom,supply-min-voltage = <0xd6d80>;
				qcom,supply-name = "vdda-0p9";
				reg = <0x0>;
			};
		};
	};

	mdss_dsi_phy1: qcom,mdss_dsi_phy1@ae97500 {
		pll_codes_region = <&dsi_pll_codes_data>;
		qcom,dsi-pll-ssc-mode = "down-spread";
		qcom,dsi-pll-ssc-en;
		qcom,panel-allow-phy-poweroff;
		vdda-0p9-supply = <&L3I>;
		qcom,platform-lane-config = <0xa0a 0xa0a 0xa0a 0xa0a 0x8a8a>;
		qcom,platform-regulator-settings = [1d 1d 1d 1d 1d];
		qcom,platform-strength-ctrl = [55 03 55 03 55 03 55 03 55 00];
		pll-label = "dsi_pll_3nm";
		reg-names = "dsi_phy", "pll_base", "dyn_refresh_base";
		reg = <0xae97000 0xa00 0xae97500 0x400 0xae96200 0xa0>;
		#clock-cells = <0x1>;
		cell-index = <0x1>;
		label = "dsi-phy-1";
		compatible = "qcom,dsi-phy-v7.2";

		qcom,phy-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,phy-supply-entry@0 {
				qcom,supply-disable-load = <0x60>;
				qcom,supply-enable-load = <0x17ed0>;
				qcom,supply-max-voltage = <0xd6d80>;
				qcom,supply-min-voltage = <0xd6d80>;
				qcom,supply-name = "vdda-0p9";
				reg = <0x0>;
			};
		};
	};

	dsi_pll_codes_data: dsi_pll_codes {
		label = "dsi_pll_codes";
		reg = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
	};
};

#include "display/lenovo/elden-reference-panels.dtsi"
#include "display/lenovo/panel/dsi-panel-elden-nt36523-csot-3k-dsc-video.dtsi"
#include "display/lenovo/panel/dsi-panel-elden-nt36523-csot-dsc-video.dtsi"

&soc {

	ext_disp: qcom,msm-ext-disp {
		compatible = "qcom,msm-ext-disp";

		ext_disp_audio_codec: qcom,msm-ext-disp-audio-codec-rx {
			compatible = "qcom,msm-ext-disp-audio-codec-rx";
		};
	};

	qcom_msmhdcp: qcom,msm_hdcp {
		compatible = "qcom,msm-hdcp";
	};

	sde_dp_pll: qcom,dp_pll@88eb000 {
		#clock-cells = <0x1>;
		compatible = "qcom,dp-pll-3nm-v1";
	};

	sde_dp: qcom,dp_display@af54000 {
		qcom,hbr2-3-pre-emphasis = <0x20 0x2c 0x35 0x3b 0x22 0x2e 0x36 0xff 0x22 0x31 0xff 0xff 0x24 0xff 0xff 0xff>;
		qcom,hbr2-3-voltage-swing = <0x22 0x32 0x36 0x3a 0x29 0x39 0x3f 0xff 0x30 0x3f 0xff 0xff 0x3f 0xff 0xff 0xff>;
		qcom,hbr-rbr-pre-emphasis = <0x20 0x2d 0x34 0x3a 0x20 0x2e 0x35 0xff 0x20 0x2e 0xff 0xff 0x22 0xff 0xff 0xff>;
		qcom,hbr-rbr-voltage-swing = <0x27 0x2f 0x36 0x3f 0x31 0x3e 0x3f 0xff 0x36 0x3f 0xff 0xff 0x3f 0xff 0xff 0xff>;
		dp_phy_gdsc-supply = <&gcc_usb3_phy_gdsc>;
		vdd_mx-supply = <&VDD_MXA_LEVEL>;
		vdda_usb-0p9-supply = <&L2D>;
		vdda-0p9-supply = <&L2D>;
		vdda-1p2-supply = <&L3G>;
		qcom,qos-cpu-latency-us = <0x12c>;
		qcom,qos-cpu-mask = <0xf>;
		qcom,dsc-continuous-pps;
		qcom,fec-feature-enable;
		qcom,dsc-feature-enable;
		qcom,mst-enable;
		qcom,4ppc-enable;
		qcom,widebus-enable;
		qcom,max-pclk-frequency-khz = <0xa4cb8>;
		qcom,aux-cfg9-settings = [44 03];
		qcom,aux-cfg8-settings = [40 b7];
		qcom,aux-cfg7-settings = [3c 03];
		qcom,aux-cfg6-settings = [38 0a];
		qcom,aux-cfg5-settings = [34 26];
		qcom,aux-cfg4-settings = [30 0a];
		qcom,aux-cfg3-settings = ",";
		qcom,aux-cfg2-settings = [28 a4];
		qcom,aux-cfg1-settings = [24 13];
		qcom,aux-cfg0-settings = " ";
		qcom,phy-version = <0x800>;
		qcom,dp-pll = <&sde_dp_pll>;
		clock-names = "core_aux_clk", "rpmh_cxo_clk", "core_usb_ref_clk_src", "core_usb_pipe_clk", "link_clk", "link_clk_src", "link_parent", "link_iface_clk", "pixel_clk_rcg", "pixel_parent", "pixel1_clk_rcg", "strm0_pixel_clk", "strm1_pixel_clk";
		clocks = <&dispcc 0x10 &rpmhcc 0x0 &tcsrcc 0x3 &gcc 0xa5 &dispcc 0x13 &dispcc 0x14 &sde_dp_pll 0x0 &dispcc 0x16 &dispcc 0x18 &sde_dp_pll 0x1 &dispcc 0x1a &dispcc 0x17 &dispcc 0x19>;
		#clock-cells = <0x1>;
		interrupts = <0xc 0x0>;
		interrupt-parent = <&mdss_mdp>;
		reg-names = "dp_ahb", "dp_aux", "dp_link", "dp_p0", "dp_phy", "dp_ln_tx0", "dp_ln_tx1", "dp_pll", "usb3_dp_com", "hdcp_physical", "dp_p1", "gdsc";
		reg = <0xaf54000 0x104 0xaf54200 0xc0 0xaf55000 0x770 0xaf56000 0x9c 0x88ebc00 0x200 0x88eb400 0x200 0x88eb800 0x200 0x88eb000 0x200 0x88e8000 0x20 0xaee1000 0x34 0xaf57000 0x9c 0xaf09000 0x14>;
		qcom,dp-aux-switch = <&fsa4480>;
		qcom,altmode-dev = <&altmode 0x0>;
		usb-controller = <&usb0>;
		qcom,ext-disp = <&ext_disp>;
		usb-phy = <&usb_qmp_dp_phy>;
		compatible = "qcom,dp-display";
		cell-index = <0x0>;

		qcom,ctrl-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,ctrl-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x7530>;
				qcom,supply-max-voltage = <0x124f80>;
				qcom,supply-min-voltage = <0x124f80>;
				qcom,supply-name = "vdda-1p2";
				reg = <0x0>;
			};
		};

		qcom,phy-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,phy-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x1bd50>;
				qcom,supply-max-voltage = <0xdea80>;
				qcom,supply-min-voltage = <0xdea80>;
				qcom,supply-name = "vdda-0p9";
				reg = <0x0>;
			};

			qcom,phy-supply-entry@1 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x9c4>;
				qcom,supply-max-voltage = <0xd6d80>;
				qcom,supply-min-voltage = <0xd6d80>;
				qcom,supply-name = "vdda_usb-0p9";
				reg = <0x1>;
			};
		};

		qcom,pll-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,pll-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x0>;
				qcom,supply-max-voltage = <0xffff>;
				qcom,supply-min-voltage = <0x180>;
				qcom,supply-name = "vdd_mx";
				reg = <0x0>;
			};
		};
	};

	smmu_sde_iommu_region_partition: smmu_sde_iommu_region_partition {
		iommu-addresses = <&smmu_sde_unsec 0x0 0x60000 &smmu_sde_unsec 0xd4e23000 0x2dd000 &smmu_sde_unsec 0xd2880000 0x5780000 &smmu_sde_unsec 0xa3500000 0x2c80000 &smmu_sde_unsec 0xfc800000 0x2b00000 &smmu_sde_sec 0x0 0x20000>;
	};

	smmu_sde_unsec: qcom,smmu_sde_unsec_cb {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x41>;
		dma-coherent;
		qcom,iommu-earlymap;
		qcom,iommu-faults = "non-fatal";
		memory-region = <&smmu_sde_iommu_region_partition>;
		iommus = <&apps_smmu 0x800 0x2>;
		compatible = "qcom,smmu_sde_unsec";
	};

	smmu_sde_sec: qcom,smmu_sde_sec_cb {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x41>;
		qcom,iommu-vmid = <0xa>;
		qcom,iommu-faults = "non-fatal";
		memory-region = <&smmu_sde_iommu_region_partition>;
		iommus = <&apps_smmu 0x801 0x0>;
		compatible = "qcom,smmu_sde_sec";
	};

	sde_cesta: qcom,sde_cesta@0x0af30000 {
		power-domains = <&dispcc 0x0>;
		interconnect-names = "qcom,sde-data-bus-hw-0", "qcom,sde-data-bus-hw-1", "qcom,sde-data-bus-hw-2", "qcom,sde-data-bus-hw-3", "qcom,sde-data-bus-hw-4", "qcom,sde-data-bus-hw-5", "qcom,sde-data-bus-sw-0";
		interconnects = <&mmss_noc 0x1771 &mc_virt 0x1970 &mmss_noc 0x1b59 &mc_virt 0x1d58 &mmss_noc 0x1f41 &mc_virt 0x2140 &mmss_noc 0x2329 &mc_virt 0x2528 &mmss_noc 0x2711 &mc_virt 0x2910 &mmss_noc 0x2af9 &mc_virt 0x2cf8 &mmss_noc 0x2ee1 &mc_virt 0x30e0>;
		clock-mmrm = <0x0 0x42 0x0>;
		clock-max-rate = <0x2245cdc0 0x2245cdc0 0x124f800>;
		clock-rate = <0x2245cdc0 0x2245cdc0 0x124f800>;
		clock-names = "branch_clk", "core_clk", "xo";
		clocks = <&dispcc 0x41 &dispcc 0x42 &dispcc 0x59>;
		/* 6.12 sde_cesta also maps disp_cc (sun-sde.dtsi); stock 6.6 had no such region. */
		reg-names = "rscc", "wrapper", "scc_0", "scc_1", "scc_2", "scc_3", "scc_4", "scc_5", "disp_cc";
		reg = <0xaf20000 0x850 0xaf30000 0x60 0xaf31000 0x30 0xaf32000 0x30 0xaf33000 0x30 0xaf34000 0x30 0xaf35000 0x30 0xaf36000 0x30 0xaf0f000 0x10>;
		compatible = "qcom,sde-cesta";
		cell-index = <0x0>;
	};
};

&tlmm {

	pmx_sde: pmx_sde {

		sde_dsi_active: sde_dsi_active {

			mux {
				function = "gpio";
				pins = "gpio98";
			};

			config {
				bias-disable = <0x0>;
				drive-strength = <0x8>;
				pins = "gpio98";
			};
		};

		sde_dsi_suspend: sde_dsi_suspend {

			mux {
				function = "gpio";
				pins = "gpio98";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio98";
			};
		};

		sde_dsi1_active: sde_dsi1_active {

			mux {
				function = "gpio";
				pins = "gpio97";
			};

			config {
				bias-disable = <0x0>;
				drive-strength = <0x8>;
				pins = "gpio97";
			};
		};

		sde_dsi1_suspend: sde_dsi1_suspend {

			mux {
				function = "gpio";
				pins = "gpio97";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio97";
			};
		};

		sde_iovdd_enable: sde_iovdd_enable {

			mux {
				function = "gpio";
				pins = "gpio161";
			};

			config {
				bias-pull-up;
				output-high;
				drive-strength = <0x8>;
				pins = "gpio161";
			};
		};

		sde_iovdd_disable: sde_iovdd_disable {

			mux {
				function = "gpio";
				pins = "gpio161";
			};

			config {
				input-enable;
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio161";
			};
		};
	};

	pmx_sde_te: pmx_sde_te {

		sde_te_active: sde_te_active {

			mux {
				function = "mdp_vsync";
				pins = "gpio86";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio86";
			};
		};

		sde_te_suspend: sde_te_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio86";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio86";
			};
		};

		sde_te1_active: sde_te1_active {

			mux {
				function = "mdp_vsync";
				pins = "gpio87";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio87";
			};
		};

		sde_te1_suspend: sde_te1_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio87";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio87";
			};
		};
	};

	pmx_sde_esync: pmx_sde_esync {

		sde_esync0_active: sde_esync0_active {

			mux {
				function = "mdp_esync0_out";
				pins = "gpio88";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio88";
			};
		};

		sde_esync0_suspend: sde_esync0_suspend {

			mux {
				function = "mdp_esync0_out";
				pins = "gpio88";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio88";
			};
		};

		sde_esync1_active: sde_esync1_active {

			mux {
				function = "mdp_esync1_out";
				pins = "gpio100";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio100";
			};
		};

		sde_esync1_suspend: sde_esync1_suspend {

			mux {
				function = "mdp_esync1_out";
				pins = "gpio100";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio100";
			};
		};
	};
};

&soc {

	dsi_panel_pwr_supply_sim: dsi_panel_pwr_supply_sim {
		#size-cells = <0x0>;
		#address-cells = <0x1>;

		qcom,panel-supply-entry@0 {
			qcom,supply-post-on-sleep = <0x14>;
			qcom,supply-disable-load = <0x1f40>;
			qcom,supply-enable-load = <0x35b60>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "dummy";
			reg = <0x0>;
		};
	};

	dsi_panel_pwr_supply: dsi_panel_pwr_supply {
		#size-cells = <0x0>;
		#address-cells = <0x1>;

		qcom,panel-supply-entry@0 {
			qcom,supply-post-on-sleep = <0x14>;
			qcom,supply-disable-load = <0xafc8>;
			qcom,supply-enable-load = <0x25990>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "vddio";
			reg = <0x0>;
		};

		qcom,panel-supply-entry@1 {
			qcom,supply-post-on-sleep = <0x0>;
			qcom,supply-disable-load = <0x1d7>;
			qcom,supply-enable-load = <0x35b60>;
			qcom,supply-max-voltage = <0x10c8e0>;
			qcom,supply-min-voltage = <0xf4240>;
			qcom,supply-name = "vdd";
			reg = <0x1>;
		};

		qcom,panel-supply-entry@2 {
			qcom,supply-post-on-sleep = <0x0>;
			qcom,supply-disable-load = <0x12c>;
			qcom,supply-enable-load = <0x2710>;
			qcom,supply-max-voltage = <0x2dc6c0>;
			qcom,supply-min-voltage = <0x2dc6c0>;
			qcom,supply-name = "vci";
			reg = <0x2>;
		};

		qcom,panel-supply-entry@3 {
			qcom,supply-post-on-sleep = <0x14>;
			qcom,supply-disable-load = <0x0>;
			qcom,supply-enable-load = <0x0>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "tvdd";
			reg = <0x3>;
		};
	};

	dsi_panel_pwr_supply_avdd: dsi_panel_pwr_supply_avdd {
		#size-cells = <0x0>;
		#address-cells = <0x1>;

		qcom,panel-supply-entry@0 {
			qcom,supply-post-on-sleep = <0x14>;
			qcom,supply-disable-load = <0x1f40>;
			qcom,supply-enable-load = <0x35b60>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "vddio";
			reg = <0x0>;
		};

		qcom,panel-supply-entry@1 {
			qcom,supply-disable-load = <0x64>;
			qcom,supply-enable-load = <0x3f7a0>;
			qcom,supply-max-voltage = <0x5b8d80>;
			qcom,supply-min-voltage = <0x4630c0>;
			qcom,supply-name = "avdd";
			reg = <0x1>;
		};
	};

	sde_dsi: qcom,dsi-display-primary {
		tvdd-supply = <&L4B>;
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk", "esync_clk_rcg";
		clocks = <&mdss_dsi_phy0 0x0 &mdss_dsi_phy0 0x1 &mdss_dsi_phy1 0x0 &mdss_dsi_phy1 0x1 &dispcc 0x41 &dispcc 0x1>;
		qcom,demura-panel-id = <0x122e700 0x471>;
		qcom,dsi-default-panel = <&elden_nt36523_csot_3k_dsc_vid>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x0>;
		qcom,platform-te-gpio = <&tlmm 0x56 0x0>;
		pinctrl-4 = <&sde_iovdd_disable>;
		pinctrl-3 = <&sde_iovdd_enable>;
		pinctrl-2 = <&sde_dsi_suspend &sde_te_suspend>;
		pinctrl-1 = <&sde_dsi_active &sde_te_active>;
		pinctrl-0 = <&sde_dsi_active &sde_te_active>;
		pinctrl-names = "panel_active", "panel_active_with_esync", "panel_suspend", "iovdd_enable", "iovdd_disable";
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		label = "primary";
		compatible = "qcom,dsi-display";
	};

	sde_dsi1: qcom,dsi-display-secondary {
		tvdd-supply = <&L4B>;
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk", "esync_clk_rcg";
		clocks = <&mdss_dsi_phy0 0x0 &mdss_dsi_phy0 0x1 &mdss_dsi_phy1 0x0 &mdss_dsi_phy1 0x1 &dispcc 0x41 &dispcc 0x3>;
		qcom,demura-panel-id = <0x0 0x0>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x1>;
		qcom,platform-te-gpio = <&tlmm 0x57 0x0>;
		pinctrl-2 = <&sde_dsi1_suspend &sde_te1_suspend &sde_esync1_suspend>;
		pinctrl-1 = <&sde_dsi1_active &sde_te1_active &sde_esync1_active>;
		pinctrl-0 = <&sde_dsi1_active &sde_te1_active &sde_esync1_suspend>;
		pinctrl-names = "panel_active", "panel_active_with_esync", "panel_suspend";
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		label = "secondary";
		compatible = "qcom,dsi-display";
	};
};

&tlmm {

	pmx_bl: pmx_bl {

		bl_active: bl_active {

			mux {
				function = "gpio";
				pins = "gpio88";
			};

			config {
				output-high;
				bias-disable;
				drive-strength = <0x8>;
				pins = "gpio88";
			};
		};

		bl_sleep: bl_sleep {

			mux {
				function = "gpio";
				pins = "gpio88";
			};

			config {
				input-enable;
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio88";
			};
		};

		bias_enp_active: bias_enp_active {

			mux {
				function = "gpio";
				pins = "gpio72";
			};

			config {
				output-high;
				bias-pull-up;
				drive-strength = <0x10>;
				pins = "gpio72";
			};
		};

		bias_enp_sleep: bias_enp_sleep {

			mux {
				function = "gpio";
				pins = "gpio72";
			};

			config {
				output-low;
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio72";
			};
		};

		bias_enn_active: bias_enn_active {

			mux {
				function = "gpio";
				pins = "gpio73";
			};

			config {
				output-high;
				bias-pull-up;
				drive-strength = <0x10>;
				pins = "gpio73";
			};
		};

		bias_enn_sleep: bias_enn_sleep {

			mux {
				function = "gpio";
				pins = "gpio73";
			};

			config {
				output-low;
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio73";
			};
		};
	};
};

&qupv3_se10_i2c {
	status = "okay";

	bias@3e {
		pinctrl-3 = <&bias_enn_sleep>;
		pinctrl-2 = <&bias_enp_sleep>;
		pinctrl-1 = <&bias_enn_active>;
		pinctrl-0 = <&bias_enp_active>;
		pinctrl-names = "enp_active", "enn_active", "enp_sleep", "enn_sleep";
		reg = <0x3e>;
		compatible = "bias";
	};

	bl@11 {
		pinctrl-1 = <&bl_sleep>;
		pinctrl-0 = <&bl_active>;
		pinctrl-names = "default", "sleep";
		reg = <0x11>;
		compatible = "i2c-backlight";
	};

	bl@76 {
		pinctrl-1 = <&bl_sleep>;
		pinctrl-0 = <&bl_active>;
		pinctrl-names = "default", "sleep";
		reg = <0x76>;
		compatible = "i2c-backlight";
	};
};

&soc {

	sde_wb1: qcom,wb-display@1 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x41>;
		label = "wb_display1";
		cell-index = <0x0>;
		compatible = "qcom,wb-display";
	};

	sde_wb2: qcom,wb-display@2 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x41>;
		label = "wb_display2";
		cell-index = <0x1>;
		compatible = "qcom,wb-display";
	};

	display_panel_avdd: display_gpio_regulator@1 {
		pinctrl-names = "default";
		qcom,proxy-consumer-enable;
		proxy-supply = <&display_panel_avdd>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pm8550_gpios 0xb 0x0>;
		regulator-enable-ramp-delay = <0xe9>;
		regulator-max-microvolt = <0x53ec60>;
		regulator-min-microvolt = <0x53ec60>;
		regulator-name = "display_panel_avdd";
		compatible = "qti-regulator-fixed";
	};

	disp_rdump_memory: disp_rdump_region@0xd5500000 {
		label = "disp_rdump_region";
		reg = <0xfc800000 0x800000>;
	};
};

&reserved_memory {

	splash_memory: splash_region {
		label = "cont_splash_region";
		reg = <0x0 0xfc800000 0x0 0x2b00000>;
	};

	demura_memory_0: demura_region_0 {
		label = "demura hfc region 0";
		reg = <0x0 0x0 0x0 0x0>;
	};

	demura_memory_1: demura_region_1 {
		label = "demura hfc region 1";
		reg = <0x0 0x0 0x0 0x0>;
	};
};

&qupv3_se10_i2c {
	status = "okay";
	#size-cells = <0x0>;
	#address-cells = <0x1>;

	i2c_wl2868c@2F {
		pinctrl-0 = <&cam_ldo_en_gpio>;
		pinctrl-names = "default";
		reg = <0x2f>;
		compatible = "will,wl2868c";

		wl2868c_l1: ldo_1 {
			regulator-max-microvolt = <0x171240>;
			regulator-min-microvolt = <0x79180>;
			regulator-name = "ldo_1";
			ldo-channel = <0x0>;
		};

		wl2868c_l2: ldo_2 {
			regulator-max-microvolt = <0x171240>;
			regulator-min-microvolt = <0x79180>;
			regulator-name = "ldo_2";
			ldo-channel = <0x1>;
		};

		wl2868c_l3: ldo_3 {
			regulator-max-microvolt = <0x3613c0>;
			regulator-min-microvolt = <0x16f300>;
			regulator-name = "ldo_3";
			ldo-channel = <0x2>;
		};

		wl2868c_l4: ldo_4 {
			regulator-max-microvolt = <0x3613c0>;
			regulator-min-microvolt = <0x16f300>;
			regulator-name = "ldo_4";
			ldo-channel = <0x3>;
		};

		wl2868c_l5: ldo_5 {
			regulator-max-microvolt = <0x3613c0>;
			regulator-min-microvolt = <0x16f300>;
			regulator-name = "ldo_5";
			ldo-channel = <0x4>;
		};

		wl2868c_l6: ldo_6 {
			regulator-max-microvolt = <0x3613c0>;
			regulator-min-microvolt = <0x16f300>;
			regulator-name = "ldo_6";
			ldo-channel = <0x5>;
		};

		wl2868c_l7: ldo_7 {
			regulator-max-microvolt = <0x3613c0>;
			regulator-min-microvolt = <0x16f300>;
			regulator-name = "ldo_7";
			ldo-channel = <0x6>;
		};
	};
};
