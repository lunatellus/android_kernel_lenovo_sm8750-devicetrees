&soc {

	tlmm: pinctrl@0x400000 {
		compatible = "qcom,shikra-tlmm";
		reg = <0x400000 0x800000>;
		interrupts = <GIC_SPI 227 IRQ_TYPE_LEVEL_HIGH>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		wakeup-parent = <&mpm>;
		qcom,gpios-reserved = <115 116 6 7 8 9 14 15 16 17 138>;

		dmic_eldo_en_pin: dmic_eldo_en_pin {
			dmic_eldo_en_pin_audio_active: dmic_eldo_en_pin_audio_active {
				mux {
					pins = "gpio71";
					function = "gpio";
				};

				config {
					pins = "gpio71";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;
					output-high;
				};
			};

			dmic_eldo_en_pin_audio_sleep: dmic_eldo_en_pin_audio_sleep {
				mux {
					pins = "gpio71";
					function = "gpio";
				};

				config {
					pins = "gpio71";
					drive-strength = <2>;   /* 2 mA */
					bias-disable;
					output-low;
				};
			};
		};

		tlmm_i2s0_pins: tlmm_i2s0_pins {
			tlmm_i2s0_sck_active: tlmm_i2s0_sck_active {
				mux {
					pins = "gpio105";
					function = "i2s0_clk";
				};

				config {
					pins = "gpio105";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_sck_sleep: tlmm_i2s0_sck_sleep {
				mux {
					pins = "gpio105";
					function = "gpio";
				};

				config {
					pins = "gpio105";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};

			tlmm_i2s0_ws_active: tlmm_i2s0_ws_active {
				mux {
					pins = "gpio106";
					function = "i2s0_ws";
				};

				config {
					pins = "gpio106";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_ws_sleep: tlmm_i2s0_ws_sleep {
				mux {
					pins = "gpio106";
					function = "gpio";
				};

				config {
					pins = "gpio106";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};

			tlmm_i2s0_data0_active: tlmm_i2s0_data0_active {
				mux {
					pins = "gpio107";
					function = "i2s0_data0";
				};

				config {
					pins = "gpio107";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_data0_sleep: tlmm_i2s0_data0_sleep {
				mux {
					pins = "gpio107";
					function = "gpio";
				};

				config {
					pins = "gpio107";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};

			tlmm_i2s0_data1_active: tlmm_i2s0_data1_active {
				mux {
					pins = "gpio108";
					function = "i2s0_data1";
				};

				config {
					pins = "gpio108";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_data1_sleep: tlmm_i2s0_data1_sleep {
				mux {
					pins = "gpio108";
					function = "gpio";
				};

				config {
					pins = "gpio108";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};

			tlmm_i2s0_data2_active: tlmm_i2s0_data2_active {
				mux {
					pins = "gpio109";
					function = "i2s0_data2";
				};

				config {
					pins = "gpio109";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_data2_sleep: tlmm_i2s0_data2_sleep {
				mux {
					pins = "gpio109";
					function = "gpio";
				};

				config {
					pins = "gpio109";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};

			tlmm_i2s0_data3_active: tlmm_i2s0_data3_active {
				mux {
					pins = "gpio110";
					function = "i2s0_data3";
				};

				config {
					pins = "gpio110";
					drive-strength = <8>;   /* 8 mA */
					bias-disable;           /* NO PULL */
					output-high;
				};
			};

			tlmm_i2s0_data3_sleep: tlmm_i2s0_data3_sleep {
				mux {
					pins = "gpio110";
					function = "gpio";
				};

				config {
					pins = "gpio110";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};
		};

		tlmm_i2s1_pins: tlmm_i2s1_pins {
			tlmm_i2s1_clk_active: tlmm_i2s1_clk_active {
				mux {
					pins = "gpio96";
