					drive-strength = <2>;
					bias-pull-up;
				};
			};
		};

		pndr_spkr_sd_n: pndr_spkr_sd_n {
			pins = "gpio2";
			function = "gpio";
			input-disable;
			output-enable;
		};

		sdc1_on: sdc1_on {
			clk {
				pins = "sdc1_clk";
				bias-disable;
				drive-strength = <6>;
			};


			cmd {
				pins = "sdc1_cmd";
				bias-pull-up;
				drive-strength = <6>;
			};


			data {
				pins = "sdc1_data";
				bias-pull-up;
				drive-strength = <6>;
			};

			rclk {
				pins = "sdc1_rclk";
				bias-pull-down;
				drive-strength = <4>;
			};
		};

		sdc1_off: sdc1_off {
			clk {
				pins = "sdc1_clk";
				drive-strength = <2>;
				bias-bus-hold;
			};

			cmd {
				pins = "sdc1_cmd";
				drive-strength = <2>;
				bias-bus-hold;
			};

			data {
				pins = "sdc1_data";
				drive-strength = <2>;
				bias-bus-hold;
			};

			rclk {
				pins = "sdc1_rclk";
				drive-strength = <2>;
				bias-bus-hold;
			};
		};

		sdc2_on: sdc2_on {
			clk {
				pins = "sdc2_clk";
				bias-disable;
				drive-strength = <14>;
			};

			cmd {
				pins = "sdc2_cmd";
				bias-pull-up;
				drive-strength = <14>;
			};

			data {
				pins = "sdc2_data";
				bias-pull-up;
				drive-strength = <14>;
			};

			sd-cd {
				pins = "gpio89";
				bias-pull-up;
				drive-strength = <2>;
			};
		};

		sdc2_off: sdc2_off {
			clk {
				pins = "sdc2_clk";
				bias-disable;
				drive-strength = <2>;
			};

			cmd {
				pins = "sdc2_cmd";
				bias-pull-up;
				drive-strength = <2>;
			};

			data {
				pins = "sdc2_data";
				bias-pull-up;
				drive-strength = <2>;
			};

			sd-cd {
				pins = "gpio89";
				bias-pull-up;
				drive-strength = <2>;
			};
		};

		touch_panel_extavdd_default: touch_panel_extavdd_default {
			mux {
				pins = "gpio63";
				function = "gpio";
			};

			config {
				pins = "gpio63";
				drive-strength = <8>;
				bias-disable = <0>;
				output-high;
			};
		};
	};
};
