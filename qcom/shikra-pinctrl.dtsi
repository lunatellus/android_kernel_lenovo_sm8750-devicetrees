				};
			};

			tlmm_i2s1_data1_sleep: tlmm_i2s1_data1_sleep {
				mux {
					pins = "gpio99";
					function = "gpio";
				};

				config {
					pins = "gpio99";
					drive-strength = <2>;   /* 2 mA */
					bias-pull-down;         /* PULL DOWN */
					input-enable;
				};
			};
		};

		tlmm_i2s2_pins: tlmm_i2s2_pins {
			tlmm_i2s2_clk_active: tlmm_i2s2_clk_active {
				mux {
