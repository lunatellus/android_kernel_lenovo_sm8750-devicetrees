	rpmh-regulator-gfxlvl {
		compatible = "qcom,rpmh-arc-regulator";
		qcom,resource-name = "gfx.lvl";

		VDD_GFX_LEVEL: S1C_LEVEL: S1C_E0_LEVEL:
		pm_f10_c_s1_level: regulator-pm-f10-c-s1-level {
			regulator-name = "pm_f10_c_s1_level";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt =
				<RPMH_REGULATOR_LEVEL_RETENTION>;
			regulator-max-microvolt =
				<RPMH_REGULATOR_LEVEL_MAX>;
			qcom,init-voltage-level =
				<RPMH_REGULATOR_LEVEL_RETENTION>;
		};
	};

	rpmh-regulator-gmxclvl {
		compatible = "qcom,rpmh-arc-regulator";
		qcom,resource-name = "gmxc.lvl";

		VDD_MX_GFX_LEVEL: VDD_GFX_MXC_LEVEL: S8C_LEVEL: S8C_E0_LEVEL:
		pm_f10_c_s8_level: regulator-pm-f10-c-s8-level {
			regulator-name = "pm_f10_c_s8_level";
