#include <dt-bindings/regulator/qcom,rpmh-regulator-levels.h>

&apps_rsc_drv2 {
	rpmh-regulator-b1b-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "B1B_E0";

		BOB1: BOB1_E0: pmh0101_bob1: regulator-pmh0101-bob1 {
			regulator-name = "pmh0101_bob1";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <4224000>;
			qcom,init-voltage = <3424000>;
		};
	};

	rpmh-regulator-b2b-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "B2B_E0";

		BOB2: BOB2_E0: pmh0101_bob2: regulator-pmh0101-bob2 {
			regulator-name = "pmh0101_bob2";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt = <2720000>;
			regulator-max-microvolt = <3008000>;
			qcom,init-voltage = <2720000>;
		};
	};

	rpmh-regulator-l1b-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "L1B_E0";
		qcom,regulator-type = "pmic7-ldo";
		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
					RPMH_REGULATOR_MODE_HPM>;
		qcom,mode-threshold-currents = <0 30000>;

		L1B: L1B_E0: pmh0101_l1: regulator-pmh0101-l1 {
			regulator-name = "pmh0101_l1";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			qcom,init-voltage = <1800000>;
			qcom,init-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	rpmh-regulator-l2b-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "L2B_E0";
		qcom,regulator-type = "pmic7-ldo";
		qcom,supported-modes = <RPMH_REGULATOR_MODE_LPM
					RPMH_REGULATOR_MODE_HPM>;
		qcom,mode-threshold-currents = <0 20000>;

		L2B: L2B_E0: pmh0101_l2: regulator-pmh0101-l2 {
