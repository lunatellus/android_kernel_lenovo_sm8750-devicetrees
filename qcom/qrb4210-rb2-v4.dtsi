#include "qrb4210-rb2-v3.dtsi"

&aliases {
	hsuart1 = &qupv3_se0_4uart;
};

&sdhc_1 {
	boot_device_type = <0x7>;
};

&pm6125_vadc {
	pinctrl-0 = <&camera_therm_default &emmc_therm_default &key_therm_default>;

	key_therm {
		reg = <ADC5_GPIO3_100K_PU>;
		label = "key_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm6125_gpios {
	key_therm {
		key_therm_default: key_therm_default {
			pins = "gpio8";
			power-source = <1>;
		};
	};

};

&pm6125_gpios {
	lcd_backlight_ctrl {
		lcd_backlight_pwm_default: lcd_backlight_pwm_default {
			pins = "gpio7";
			function = "func1";
			input-disable;
			output-enable;
			bias-disable;
			power-source = <1>;       /* 1.8V */
			qcom,drive-strength = <2>;
		};
	};
};

&spmi_bus {
	qcom,pm6125@0 {
		pm6125_adc_tm_iio: adc_tm@3400 {
			/delete-property/ io-channels;
			io-channels = <&pm6125_vadc ADC5_GPIO1_100K_PU>,
					<&pm6125_vadc ADC5_GPIO2_100K_PU>,
					<&pm6125_vadc ADC5_GPIO3_100K_PU>;

			key_therm {
				reg = <ADC5_GPIO3_100K_PU>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};
		};
	};

};

&tlmm {
	/delete-node/ pmx_sde;
	/delete-node/ pmx_sde_te;

	qupv3_se0_4uart_pins: qupv3_se0_4uart_pins {
		qupv3_se0_default_cts:
			qupv3_se0_default_cts {
			mux {
				pins = "gpio0";
				function = "gpio";
			};

			config {
				pins = "gpio0";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se0_default_rts:
			qupv3_se0_default_rts {
			mux {
				pins = "gpio1";
				function = "gpio";
			};

			config {
				pins = "gpio1";
				drive-strength = <2>;
				bias-pull-down;
			};
		};

		qupv3_se0_default_tx:
			qupv3_se0_default_tx {
			mux {
				pins = "gpio2";
				function = "gpio";
			};

			config {
				pins = "gpio2";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		qupv3_se0_default_rx:
			qupv3_se0_default_rx {
			mux {
				pins = "gpio3";
				function = "gpio";
			};

			config {
				pins = "gpio3";
				drive-strength = <2>;
				bias-pull-down;
			};
		};

		qupv3_se0_cts: qupv3_se0_cts {
			mux {
				pins = "gpio0";
				function = "qup0";
			};

			config {
				pins = "gpio0";
				drive-strength = <2>;
				bias-disable;
			};
		};


		qupv3_se0_rts: qupv3_se0_rts {
			mux {
				pins = "gpio1";
				function = "qup0";
			};

			config {
				pins = "gpio1";
				drive-strength = <2>;
				bias-pull-down;
			};
		};

		qupv3_se0_tx: qupv3_se0_tx {
			mux {
				pins = "gpio2";
				function = "qup0";
			};

			config {
				pins = "gpio2";
				drive-strength = <2>;
				bias-pull-up;
			};
		};

		qupv3_se0_rx: qupv3_se0_rx {
			mux {
				pins = "gpio3";
				function = "qup0";
			};

			config {
				pins = "gpio3";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};

};

&qupv3_0 {
	/delete-node/ i2c@4a80000;

	qupv3_se0_4uart: qcom,qup_uart@4a80000 {
		status = "disabled";
		compatible = "qcom,msm-geni-serial-hs";
		reg = <0x4a80000 0x4000>;
		reg-names = "se_phys";
		interrupts = <GIC_SPI 327 IRQ_TYPE_LEVEL_HIGH>;
		clock-names = "se-clk";
		clocks = <&gcc GCC_QUPV3_WRAP0_S0_CLK>;
		interconnect-names = "qup-core", "qup-config", "qup-memory";
		interconnects = <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
		<&bimc MASTER_AMPSS_M0 &config_noc SLAVE_QUP_0>,
		<&system_noc MASTER_QUP_0 &bimc SLAVE_EBI_CH0>;
		pinctrl-names = "default", "active", "sleep", "shutdown";
		pinctrl-0 = <&qupv3_se0_default_cts>, <&qupv3_se0_default_rts>,
			<&qupv3_se0_default_tx>, <&qupv3_se0_default_rx>;
		pinctrl-1 = <&qupv3_se0_cts>, <&qupv3_se0_rts>,
			<&qupv3_se0_tx>, <&qupv3_se0_rx>;
		pinctrl-2 = <&qupv3_se0_cts>, <&qupv3_se0_rts>,
			<&qupv3_se0_tx>, <&qupv3_se0_default_rx>;
		pinctrl-3 = <&qupv3_se0_default_cts>, <&qupv3_se0_default_rts>,
			<&qupv3_se0_default_tx>, <&qupv3_se0_default_rx>;
		qcom,wrapper-core = <&qupv3_0>;
		dmas = <&gpi_dma0 0 0 2 64 0>,
			<&gpi_dma0 1 0 2 64 0>;
		dma-names = "tx", "rx";
	};
};

&qupv3_se1_i2c {
	status = "ok";

	/delete-node/ ch_io_expander@22;

	ioexp20: i2c1gpio-expander@20 {
		compatible = "semtech,sx1508q";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		semtech,probe-reset;

		sx1508q_lcd0_vdd_1v8_active: sx1508q_lcd0_vdd_1v8_active {
			pins = "gpio6";
			bias-disable;
			output-high;
		};

		sx1508q_lcd0_vdd_1v8_sleep: sx1508q_lcd0_vdd_1v8_sleep {
			pins = "gpio6";
			bias-disable;
			output-low;
		};

		sx1508q_lcd0_vsp_active: sx1508q_lcd0_vsp_active {
			pins = "gpio7";
			bias-disable;
			output-high;
		};

		sx1508q_lcd0_vsp_sleep: sx1508q_lcd0_vsp_sleep {
			pins = "gpio7";
			bias-disable;
			output-low;
		};
	};

	ioexp21: i2c1gpio-expander@21 {
		compatible = "semtech,sx1508q";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;

		semtech,probe-reset;

		sx1508q_lcd0_vsn_active: sx1508q_lcd0_vsn_active {
			pins = "gpio1";
			bias-disable;
			output-high;
		};

		sx1508q_lcd0_vsn_sleep: sx1508q_lcd0_vsn_sleep {
			pins = "gpio1";
			bias-disable;
			output-low;
		};

		sx1508q_lcd0_bl_active: sx1508q_lcd0_bl_active {
			pins = "gpio3";
			bias-disable;
			output-high;
		};

		sx1508q_lcd0_bl_sleep: sx1508q_lcd0_bl_sleep {
			pins = "gpio3";
			bias-disable;
			output-low;
		};

		sx1508_cam1_pwdn_active: sx1508_cam1_pwdn_active {
			pins = "gpio4";
			bias-disable;
			output-high;
		};
	};

	ioexp22: i2c1gpio-expander@22 {
		compatible = "semtech,sx1508q";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;

		semtech,probe-reset;

		sx1508_touch_power_active: sx1508_touch_power_active {
			pins = "gpio7";
			bias-disable;
			output-high;
		};

		sx1508_touch_power_sleep: sx1508_touch_power_sleep {
			pins = "gpio7";
			bias-disable;
			output-low;
		};
	};

	ioexp23: i2c1gpio-expander@23 {
		compatible = "semtech,sx1508q";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;

		semtech,probe-reset;

		sx1508_cam1_strobe_active: sx1508_cam1_strobe_active {
			pins = "gpio2";
			bias-disable;
			output-high;
		};

		sx1508_cam2_strobe_active: sx1508_cam2_strobe_active {
			pins = "gpio3";
			bias-disable;
			output-high;
		};

		sx1508_cam2_pwdn_active: sx1508_cam2_pwdn_active {
			pins = "gpio5";
			bias-disable;
			output-high;
		};

		sx1508_gmsl_power_active: sx1508_gmsl_power_active {
			pins = "gpio7";
			bias-disable;
			output-high;
		};
	};

	touch: gt1151@14 {
		compatible = "goodix,gt1151";
		reg = <0x14>;

		interrupts-extended = <&tlmm 3 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&tlmm 3 0x2002>;
		reset-gpios = <&tlmm 2 0>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&sx1508_touch_power_active>;
		pinctrl-1 = <&sx1508_touch_power_sleep>;

		goodix,config-name = "gt1151_cfg.bin";
	};
};
