/* stock fragment@8 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pmd802x@4 {
		compatible = "qcom,spmi-pmic";
		reg = <0x4 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pmd802x_tz: pmd802x-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x4 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};

		pmd802x_gpios: pinctrl@8800 {
			compatible = "qcom,pmd802x-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
		};

		amoled-ecm@f900 {
			compatible = "qcom,amoled-ecm";
			reg = <0xf900>;
			nvmem-names = "amoled-ecm-sdam0", "amoled-ecm-sdam1", "amoled-ecm-sdam2";
			nvmem = <&pmk8550_sdam_13 &pmk8550_sdam_14 &pmk8550_sdam_41>;
			interrupt-names = "ecm-sdam0", "ecm-sdam1", "ecm-sdam2";
			interrupts = <0x0 0x7c 0x1 0x1 0x0 0x7d 0x1 0x1 0x0 0x98 0x1 0x1>;
		};

		qcom-amoled {
			compatible = "qcom,amoled-regulator";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			nvmem-cells = <&ibb_spur_sqm_timer>;
			nvmem-cell-names = "ibb_spur_sqm_timer";
			status = "disabled";

			ibb_vreg: ibb@f800 {
				reg = <0xf800>;
				reg-names = "ibb_base";
				regulator-name = "ibb";
				regulator-min-microvolt = <0xc3500>;
				regulator-max-microvolt = <0x895440>;
				regulator-allow-set-load;
				qcom,swire-control;
			};

			ab_vreg: elvdd@f900 {
				reg = <0xf900>;
				reg-names = "ab_base";
				regulator-name = "ab";
				regulator-min-microvolt = <0x2625a0>;
				regulator-max-microvolt = <0x53ec60>;
				qcom,swire-control;
			};

			oledb_vreg: oledb@fa00 {
				reg = <0xfa00>;
				reg-names = "oledb_base";
				regulator-name = "oledb";
				regulator-min-microvolt = <0x4c4b40>;
				regulator-max-microvolt = <0x7a1200>;
				qcom,swire-control;
			};
		};
	};
};

/* stock fragment@10 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pmih010x@7 {
		compatible = "qcom,spmi-pmic";
		reg = <0x7 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pmih010x_tz: pmih010x-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x7 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x703>;
			io-channel-names = "thermal";
		};

		pmih010x_lite_tz: pmih010x-temp-alarm-lite@c00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xc00>;
			interrupts = <0x7 0xc 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x718>;
			io-channel-names = "thermal";
		};

		pmih010x_gpios: pinctrl@8800 {
			compatible = "qcom,pmih010x-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;

			ufs_therm {

				ufs_therm_default: ufs_therm_default {
					pins = "gpio15";
					bias-high-impedance;
				};
			};

			fcam_ntc {

				fcam_ntc_default: fcam_ntc_default {
					pins = "gpio18";
					bias-high-impedance;
				};
			};

			top_chg_therm {

				top_chg_therm_default: top_chg_therm_default {
					pins = "gpio12";
					bias-high-impedance;
				};
			};

			batt2_pack_therm {

				batt2_pack_therm_default: batt2_pack_therm_default {
					pins = "gpio16";
					bias-high-impedance;
				};
			};
		};

		pmih010x_eusb2_repeater: eusb2-repeater@fd00 {
			compatible = "qcom,pmic-eusb2-repeater";
			reg = <0xfd00>;
			vdd18-supply = <&pm_humu_l15>;
			vdd3-supply = <&pm_humu_l5>;
		};

		pmih010x_haptics: qcom,hv-haptics@f000 {
			compatible = "qcom,hv-haptics";
			reg = <0xf000 0xf100 0xf200>;
			interrupts = <0x7 0xf0 0x1 0x1>;
			interrupt-names = "fifo-empty";
			qcom,vmax-mv = <0xe10>;
			qcom,lra-period-us = <0x1a0b>;
			qcom,brake-mode = <0x1>;
			qcom,brake-pattern = [ff 3f 1f];
			qcom,drv-sig-shape = <0x1>;
			qcom,brake-sig-shape = <0x1>;
			qcom,rt-imp-detect;
			nvmem-names = "hap_cfg_sdam";
			nvmem = <&pmk8550_sdam_46>;

			hap_swr_slave_reg: qcom,hap-swr-slave-reg {
				regulator-name = "hap-swr-slave-reg";
			};

			effect_0 {
				qcom,effect-id = <0x0>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = <0x7f7f7f7f>;
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_1 {
				qcom,effect-id = <0x1>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_2 {
				qcom,effect-id = <0x2>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_3 {
				qcom,effect-id = <0x3>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_4 {
				qcom,effect-id = <0x4>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_5 {
				qcom,effect-id = <0x5>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f 7f 7f 7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_0 {
				qcom,primitive-id = <0x0>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = <0x0>;
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_1 {
				qcom,primitive-id = <0x1>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_2 {
				qcom,primitive-id = <0x2>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_3 {
				qcom,primitive-id = <0x3>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_4 {
				qcom,primitive-id = <0x4>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_5 {
				qcom,primitive-id = <0x5>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_6 {
				qcom,primitive-id = <0x6>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_7 {
				qcom,primitive-id = <0x7>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			primitive_8 {
				qcom,primitive-id = <0x8>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [7f 7f];
				qcom,wf-fifo-period = <0x0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
		};

		pmih010x_bcl: bcl@4700 {
			compatible = "qcom,bcl-v5";
			reg = <0x4700 0x100>;
			interrupts = <0x7 0x47 0x0 0x0 0x7 0x47 0x1 0x0 0x7 0x47 0x2 0x0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x1>;
		};

		pmih010x_bcl2: bcl@4900 {
			compatible = "qcom,bcl-v5";
			reg = <0x4900 0x100>;
			interrupts = <0x7 0x49 0x0 0x0 0x7 0x49 0x1 0x0 0x7 0x49 0x2 0x0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x1>;
			status = "disabled";
		};

		bcl_soc: bcl-soc {
			compatible = "qcom,msm-bcl-soc";
			#thermal-sensor-cells = <0x0>;
		};
	};
};

/* stock fragment@12 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pmk8550@0 {
		compatible = "qcom,spmi-pmic";
		reg = <0x0 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pmk8550_sdam_1: sdam@7000 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7000>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			sm1510_present: sm1510_present@5d {
				reg = <0x5d 0x1>;
				bits = <0x5 0x5>;
			};

			ocp_log: ocp-log@76 {
				reg = <0x76 0x6>;
			};
		};

		pmk8550_sdam_2: sdam@7100 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7100>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			restart_reason: restart@48 {
				reg = <0x48 0x1>;
				bits = <0x1 0x7>;
			};

			wr_thermal_flag: wr_thermal-flag@58 {
				reg = <0x58 0x1>;
			};

			alarm_log: alarm-log@76 {
				reg = <0x76 0x6>;
			};

			fmd_set: fmd-set@9a {
				reg = <0x9a 0x1>;
			};

			fmd_cont_after_pon: fmd-cont-after-pon@9c {
				reg = <0x9c 0x1>;
			};

			fmd_chg_pon: fmd-chg-pon@9f {
				reg = <0x9f 0x1>;
			};

			fmd_cnt2_stop: fmd-cnt2-stop@a2 {
				reg = <0xa2 0x1>;
			};
		};

		pmk8550_sdam_5: sdam@7400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7400>;
		};

		pmk8550_sdam_6: sdam@7500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7500>;
		};

		pmk8550_sdam_13: sdam@7c00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7c00>;
		};

		pmk8550_sdam_14: sdam@7d00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7d00>;
		};

		pmk8550_sdam_21: sdam@8400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8400>;
		};

		pmk8550_sdam_22: sdam@8500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8500>;
		};

		pmk8550_sdam_41: sdam@9800 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9800>;
		};

		pmk8550_sdam_43: sdam@9a00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9a00>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			ibb_spur_sqm_timer: sqm-timer@b8 {
				reg = <0xb8 0x2>;
			};
		};

		pmk8550_sdam_46: sdam@9d00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9d00>;
		};

		pmk8550_sdam_71: sdam@b600 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb600>;

			usb_mode: usb-mode@50 {
				reg = <0x50 0x1>;
			};
		};

		pon_hlos@1300 {
			compatible = "qcom,pm8998-pon";
			reg = <0x1300 0x800>;
			reg-names = "pon_hlos", "pon_pbs";

			pwrkey {
				compatible = "qcom,pmk8350-pwrkey";
				interrupts = <0x0 0x13 0x7 0x3>;
				linux,code = <0x74>;
			};

			resin {
				compatible = "qcom,pmk8350-resin";
				interrupts = <0x0 0x13 0x6 0x3>;
				linux,code = <0x72>;
			};
		};

		pmk8550_gpios: pinctrl@b800 {
			compatible = "qcom,pmk8550-gpio";
			reg = <0xb800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
			pinctrl-0 = <&alt_sleep_clk_default>;
			pinctrl-names = "default";

			alt_sleep_clk {

				alt_sleep_clk_default: alt_sleep_clk_default {
					pins = "gpio3";
					function = "func1";
					input-disable;
					output-enable;
					bias-disable;
					power-source = <0x0>;
				};
			};

			lcm_therm {

				lcm_therm_default: lcm_therm_default {
					pins = "gpio2";
					bias-high-impedance;
				};
			};
		};

		pmk8550_rtc: rtc@6100 {
			compatible = "qcom,pmk8350-rtc";
			reg = <0x6100 0x6200>;
			reg-names = "rtc", "alarm";
			interrupts = <0x0 0x62 0x1 0x1>;
		};

		pmk8550-pwm {
			compatible = "qcom,pmk8550-pwm";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			#pwm-cells = <0x2>;
		};

		pmk8550_vadc: vadc@9000 {
			compatible = "qcom,spmi-adc5-gen3";
			reg = <0x9000 0x9100>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			interrupt-names = "adc-sdam0", "adc-sdam1";
			interrupts = <0x0 0x90 0x1 0x1 0x0 0x91 0x1 0x1>;
			#thermal-sensor-cells = <0x1>;
			#io-channel-cells = <0x1>;
			io-channel-ranges;
			pinctrl-names = "default";
			pinctrl-0 = <&xo_therm_cust_default &quiet_therm_default &fast_chg_therm_default &ufs_therm_default &fcam_ntc_default &top_chg_therm_default &batt2_pack_therm_default &lcm_therm_default>;

			pmk8550_offset_ref {
				reg = <0x0>;
				label = "pmk8550_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pmk8550_vref_1p25 {
				reg = <0x1>;
				label = "pmk8550_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pmk8550_die_temp {
				reg = <0x3>;
				label = "pmk8550_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_offset_ref {
				reg = <0x100>;
				label = "pm8550_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_vref_1p25 {
				reg = <0x101>;
				label = "pm8550_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_die_temp {
				reg = <0x103>;
				label = "pm8550_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_vph_pwr {
				reg = <0x18e>;
				label = "pm8550_vph_pwr";
				qcom,pre-scaling = <0x1 0x3>;
			};

			pmih010x_offset_ref {
				reg = <0x700>;
				label = "pmih010x_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc5-gen4;
			};

			pmih010x_vref_1p25 {
				reg = <0x701>;
				label = "pmih010x_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc5-gen4;
			};

			pmih010x_die_temp {
				reg = <0x703>;
				label = "pmih010x_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc5-gen4;
			};

			pmih010x_vph_pwr {
				reg = <0x78e>;
				label = "pmih010x_vph_pwr";
				qcom,pre-scaling = <0x1 0x3>;
				qcom,adc5-gen4;
			};

			pmih010x_vbat_sns_qbg {
				reg = <0x78f>;
				label = "pmih010x_vbat_sns_qbg";
				qcom,pre-scaling = <0x1 0x3>;
				qcom,adc5-gen4;
			};

			pmih010x_iin {
				reg = <0x717>;
				label = "pmih010x_iin";
				qcom,adc5-gen4;
			};

			pmih010x_ichg_fb {
				reg = <0x7a1>;
				label = "pmih010x_ichg_fb";
				qcom,adc5-gen4;
			};

			pmih010x_chg_temp {
				reg = <0x710>;
				label = "pmih010x_chg_temp";
				qcom,adc5-gen4;
			};

			pmih010x_lite_die_temp {
				reg = <0x718>;
				label = "pmih010x_lite_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc5-gen4;
			};

			pm8550vs_f_die_temp {
				reg = <0x503>;
				label = "pm8550vs_f_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550vs_j_die_temp {
				reg = <0x903>;
				label = "pm8550vs_j_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550ve_d_die_temp {
				reg = <0x303>;
				label = "pm8550ve_d_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550ve_g_die_temp {
				reg = <0x603>;
				label = "pm8550ve_g_die_temp";
				qom,pre-scaling = <0x1 0x1>;
			};

			pm8550ve_i_die_temp {
				reg = <0x803>;
				label = "pm8550ve_i_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_ap_therm {
				reg = <0x144>;
				label = "pm8550_ap_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_flash_led_ntc {
				reg = <0x145>;
				label = "pm8550_flash_led_ntc";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_wlan_therm_cust {
				reg = <0x146>;
