				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_usb2_conn_therm {
				reg = <0x147>;
				label = "pm8550_usb2_conn_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_rear_cam_ntc {
