/* stock fragment@0 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	pm8010_m: qcom,pm8010@c {
		compatible = "qcom,spmi-pmic";
		reg = <0xc 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8010m_tz: pm8010m-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0xc 0x24 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};
	};

	pm8010_n: qcom,pm8010@d {
		compatible = "qcom,spmi-pmic";
		reg = <0xd 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8010n_tz: pm8010n-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0xd 0x24 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};
	};
};

/* stock fragment@2 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pm8550@1 {
		compatible = "qcom,spmi-pmic";
		reg = <0x1 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8550_tz: pm8550-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x1 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x103>;
			io-channel-names = "thermal";
		};

		pm8550_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;

			key_vol_up {

				key_vol_up_default: key_vol_up_default {
					pins = "gpio6";
					function = "normal";
					input-enable;
					bias-pull-up;
					power-source = <0x1>;
				};
			};

			xo_therm_cust {

				xo_therm_cust_default: xo_therm_cust_default {
					pins = "gpio12";
					bias-high-impedance;
				};
			};

			quiet_therm {

				quiet_therm_default: quiet_therm_default {
					pins = "gpio4";
					bias-high-impedance;
				};
			};

			fast_chg_therm {

				fast_chg_therm_default: fast_chg_therm_default {
					pins = "gpio3";
					bias-high-impedance;
				};
			};

			display_panel_avdd_default: display_panel_avdd_default {
				qcom,drive-strength = <0x3>;
				power-source = <0x1>;
				bias-disable;
				output-enable;
				input-disable;
				function = "normal";
				pins = "gpio11";
			};
		};

		led-controller {
			compatible = "qcom,pm8350c-pwm";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			#pwm-cells = <0x2>;
			nvmem = <&pmk8550_sdam_21 &pmk8550_sdam_22>;
			nvmem-names = "lpg_chan_sdam", "lut_sdam";

			led@1 {
				reg = <0x1>;
				color = <0x1>;
				label = "red";
			};

			led@2 {
				reg = <0x2>;
				color = <0x2>;
				label = "green";
			};

			led@3 {
				reg = <0x3>;
				color = <0x3>;
				label = "blue";
			};
		};

		pm8550_bcl: bcl@4700 {
			compatible = "qcom,pm8550-bcl-v5";
			reg = <0x4700 0x100>;
			interrupts = <0x1 0x47 0x0 0x0 0x1 0x47 0x1 0x0 0x1 0x47 0x2 0x0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x1>;
		};

		pm8550_flash: qcom,flash_led@ee00 {
			compatible = "qcom,qti-pm8350c-flash-led";
			reg = <0xee00>;
			interrupts = <0x1 0xee 0x0 0x1 0x1 0xee 0x3 0x1 0x1 0xee 0x4 0x1>;
			interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
			qcom,thermal-derate-current = <0xc8 0x1f4>;
			status = "ok";

			pm8550_flash0: qcom,flash_0 {
				label = "flash";
				qcom,led-name = "led:flash_0";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash0_trigger";
				qcom,id = <0x0>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_flash1: qcom,flash_1 {
				label = "flash";
				qcom,led-name = "led:flash_1";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash1_trigger";
				qcom,id = <0x1>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_flash2: qcom,flash_2 {
				label = "flash";
				qcom,led-name = "led:flash_2";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash2_trigger";
				qcom,id = <0x2>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_flash3: qcom,flash_3 {
				label = "flash";
				qcom,led-name = "led:flash_3";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash3_trigger";
				qcom,id = <0x3>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch0: qcom,torch_0 {
				label = "torch";
				qcom,led-name = "led:torch_0";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch0_trigger";
				qcom,id = <0x0>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch1: qcom,torch_1 {
				label = "torch";
				qcom,led-name = "led:torch_1";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch1_trigger";
				qcom,id = <0x1>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch2: qcom,torch_2 {
				label = "torch";
				qcom,led-name = "led:torch_2";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch2_trigger";
				qcom,id = <0x2>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch3: qcom,torch_3 {
				label = "torch";
				qcom,led-name = "led:torch_3";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch3_trigger";
				qcom,id = <0x3>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_switch0: qcom,led_switch_0 {
				label = "switch";
				qcom,led-name = "led:switch_0";
				qcom,default-led-trigger = "switch0_trigger";
				qcom,led-mask = <0x9>;
				qcom,symmetry-en;
			};

			pm8550_switch1: qcom,led_switch_1 {
				label = "switch";
				qcom,led-name = "led:switch_1";
				qcom,default-led-trigger = "switch1_trigger";
				qcom,led-mask = <0x6>;
				qcom,symmetry-en;
			};

			pm8550_switch2: qcom,led_switch_2 {
				label = "switch";
				qcom,led-name = "led:switch_2";
				qcom,default-led-trigger = "switch2_trigger";
				qcom,led-mask = <0xf>;
				qcom,symmetry-en;
			};
		};
	};
};

/* stock fragment@4 */
&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	pm8550ve_d: qcom,pm8550ve@3 {
		compatible = "qcom,spmi-pmic";
		reg = <0x3 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "ok";

		pm8550ve_d_tz: pm8550ve-d-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x3 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x303>;
			io-channel-names = "thermal";
		};

		pm8550ve_d_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550ve-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
		};
	};

	pm8550ve_f: qcom,pm8550ve@5 {
		compatible = "qcom,spmi-pmic";
		reg = <0x5 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "ok";

		pm8550ve_f_tz: pm8550ve-f-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x5 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x503>;
			io-channel-names = "thermal";
		};

		pm8550ve_f_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550ve-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;

			bt_uwb_en: bt_uwb_en {
				power-source = <0x1>;
				bias-disable;
				output-enable;
				input-disable;
				function = "normal";
				pins = "gpio3";
			};

			bt_fmd_clk_en: bt_fmd_clk_en {
				power-source = <0x1>;
				bias-disable;
				output-disable;
				input-enable;
				function = "normal";
				pins = "gpio6";
			};
		};
	};

	pm8550ve_g: qcom,pm8550ve@6 {
		compatible = "qcom,spmi-pmic";
		reg = <0x6 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "ok";

		pm8550ve_g_tz: pm8550ve-g-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x6 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x603>;
			io-channel-names = "thermal";
		};

		pm8550ve_g_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550ve-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
		};
	};

	pm8550ve_i: qcom,pm8550ve@8 {
		compatible = "qcom,spmi-pmic";
		reg = <0x8 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "ok";

		pm8550ve_i_tz: pm8550ve-i-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x8 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x803>;
			io-channel-names = "thermal";
		};

		pm8550ve_i_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550ve-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;

			eusb2_reset_ctrl {

				eusb2_reset_ctrl_default: eusb2_reset_ctrl_default {
					pins = "gpio6";
					function = "normal";
					input-enable;
					output-enable;
					bias-disable;
					power-source = <0x1>;
					qcom,drive-strength = <0x2>;
				};
			};
		};
	};
};

