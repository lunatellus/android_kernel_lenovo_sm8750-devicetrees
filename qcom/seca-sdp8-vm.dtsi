				<GIC_SPI 674 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 678 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 679 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 680 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 681 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 682 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 683 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 684 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 685 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 686 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 687 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 688 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 700 IRQ_TYPE_LEVEL_HIGH>;
		status = "ok";
	};

	kgsl_smmu_1: iommu@98a0000 {
		compatible = "qcom,qsmmu-v500";
		reg = <0x98a0000 0x40000>;
		reg-names = "base";
		#iommu-cells = <2>;
		#global-interrupts = <2>;
		dma-coherent;
		qcom,skip-init;
		qcom,reset-stream-mapping-groups;
		qcom,handoff-smrs = <0x0 0xffff>;
		qcom,multi-match-handoff-smr;
		interrupts = <GIC_SPI 851 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 852 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 853 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 854 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 855 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 856 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 857 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 858 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 859 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 920 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 921 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 922 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 924 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 925 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 926 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 927 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 928 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 929 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 931 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 932 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 936 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 937 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 938 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 939 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 940 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 941 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 942 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	dma_dev@0x0 {
		compatible = "qcom,iommu-dma";
		memory-region = <&system_cma>;
		status = "ok";
	};

	vm_restart: restart {
		compatible = "qcom,vm-restart";
		status = "ok";
	};

	pdc: interrupt-controller@b220000 {
		compatible = "qcom,pdc";
		reg = <0xb220000 0x10000>;
		qcom,pdc-ranges = <7 752 2>, <12 757 2>, <14 759 2>, <17 762 1>, <41 786 1>;
		#interrupt-cells = <2>;
		interrupt-parent = <&qvm_vdev_gic>;
		interrupt-controller;
		status = "ok";
	};

	qcom_rng_ee13: qrng@10cd000 {
		compatible = "qcom,trng";
		reg = <0x10cd000 0x1000>;
		status = "ok";
	};

	wdog: qcom,wdt@17821000 {
		compatible = "qcom,msm-watchdog";
		reg = <0x17821000 0x1000>;
		reg-names = "wdt-base";
		interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
		qcom,wdt-en-offset = <0x00>;
		qcom,wdt-rst-offset = <0x04>;
		qcom,wdt-sts-offset = <0x1C>;
		qcom,wdt-bark-offset = <0x0C>;
		qcom,wdt-bite-offset = <0x10>;
		qcom,wdt-hz = <19198242>;
		status = "ok";
	};

	qcom,secure-buffer {
		compatible = "qcom,secure-buffer";
	};

	qcom,mem-buf {
		compatible = "qcom,mem-buf";
		qcom,mem-buf-capabilities = "consumer";
		qcom,vmid = <52>;
		qcom,vm-uses-hyp-assign;
	};

	qcom,mem-buf-msgq {
		compatible = "qcom,mem-buf-msgq";
		qcom,msgq-names = "trusted_vm";
	};
};

&firmware {
	scm {
		compatible = "qcom,scm", "qcom,scm-v1.1";
		qcom,scm-hab;
	};

	qcom_mem_object {
		compatible = "qcom,mem-object";
	};

	qtee_shmbridge {
		compatible = "qcom,tee-shared-memory-bridge";
		qcom,custom-bridge-size = <512>;
		qcom,support-hypervisor;
	};
};

&hab {
	mmidgrp200: mmidgrp200 {
	    dma-coherent;
	};

	mmidgrp300: mmidgrp300 {
	    dma-coherent;
	};

	mmidgrp400: mmidgrp400 {
	    dma-coherent;
	};

	mmidgrp500: mmidgrp500 {
	    dma-coherent;
	};

	mmidgrp1700: mmidgrp1700 {
	    grp-start-id = <1700>;
	    role = "fe";
	    remote-vmids = <0>;
	};

	mmidgrp1800: mmidgrp1800 {
	    grp-start-id = <1800>;
	    role = "fe";
	    remote-vmids = <0>;
	};

	mmidgrp1900: mmidgrp1900 {
	    grp-start-id = <1900>;
	    role = "fe";
	    remote-vmids = <0>;
	};
};

&reserved_memory {
	glink_cma_mem0: glink-cma-region0 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem0";
	};

	glink_cma_mem1: glink-cma-region1 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem1";
	};

	glink_cma_mem2: glink-cma-region2 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem2";
	};

	glink_cma_mem3: glink-cma-region3 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem3";
	};

	glink_cma_mem4: glink-cma-region4 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem4";
	};

	glink_cma_mem5: glink-cma-region5 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem5";
	};

	glink_cma_mem6: glink-cma-region6 {
		no-map;
		reg = <0x0 0x0 0x0 0x0>;
		label = "glink_cma_mem6";
	};
};

#include "seca-vm-pinctrl.dtsi"
#include "seca-vm-usb.dtsi"
#include "seca-vm-qupv3.dtsi"
#include "seca-sdp8-vm-pcie.dtsi"
