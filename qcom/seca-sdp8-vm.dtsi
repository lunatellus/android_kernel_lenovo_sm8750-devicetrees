			<GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 216 IRQ_TYPE_LEVEL_HIGH>;
		gpio-controller;
		qcom,dirconn-list = <50 GPIO_ACTIVE_HIGH>;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		status = "ok";
	};

