				qcom,bus-max-ddr8 = <7>;

				qcom,acd-level = <0x882F5FFD>;
			};
		};

		qcom,gpu-pwrlevels-2 {
			#address-cells = <1>;
			#size-cells = <0>;

			qcom,speed-bin = <117>;
			qcom,initial-pwrlevel = <2>;

			qcom,gpu-pwrlevel@0 {
