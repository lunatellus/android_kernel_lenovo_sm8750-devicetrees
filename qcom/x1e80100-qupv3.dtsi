				  <&gpi_dma2 0x0 0x200000 0xffffffff 0xffe00000>;
	};

	gpi_dma2: qcom,gpi-dma@800000 {
		compatible = "qcom,gpi-dma";
		#dma-cells = <5>;
		reg = <0x0 0x800000 0x0 0x60000>;
		reg-names = "gpi-top";
		iommus = <&apps_smmu 0x0436 0x0>;
		qcom,max-num-gpii = <12>;
		interrupts = <GIC_SPI 788 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 789 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 790 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 791 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 792 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 793 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 794 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 795 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 796 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 797 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 798 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 799 IRQ_TYPE_LEVEL_HIGH>;
		qcom,gpii-mask = <0x3f>;
		qcom,ev-factor = <1>;
		memory-region = <&qup2_gpi_iommu_region>;
		qcom,gpi-ee-offset = <0x10000>;
		dma-coherent;
		status = "okay";
	};

	qup2_se_iommu_region: qup2_se_iommu_region {
		iommu-addresses = <&qupv3_id_2 0x0 0x0 0x0 0x40000000>,
				  <&qupv3_id_2 0x0 0x50000000 0xffffffff 0xb0000000>;
	};

	qupv3_id_2: qcom,qupv3_2_geni_se@8c0000 {
		compatible = "qcom,geni-se-qup";
		reg = <0x0 0x8c0000 0x0 0x2000>;
		clock-names = "m-ahb", "s-ahb";
		clocks = <&gcc GCC_QUPV3_WRAP_2_M_AHB_CLK>,
			 <&gcc GCC_QUPV3_WRAP_2_S_AHB_CLK>;
		iommus = <&apps_smmu 0x0423 0x0>;
		memory-region = <&qup2_se_iommu_region>;
		qcom,iommu-geometry = <0x0 0x40000000 0x0 0x10000000>;
		qcom,iommu-dma = "fastmap";
		dma-coherent;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		status = "okay";

		qupv3_se16_i2c: i2c@880000 {
			compatible = "qcom,i2c-geni";
			reg = <0x0 0x880000 0x0 0x4000>;
			interrupts = <GIC_SPI 808 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "se-clk";
			clocks = <&gcc GCC_QUPV3_WRAP2_S0_CLK>;
			interconnect-names = "qup-core", "qup-config", "qup-memory";
			interconnects = <&clk_virt MASTER_QUP_CORE_2 &clk_virt SLAVE_QUP_CORE_2>,
					<&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_2>,
					<&aggre1_noc MASTER_QUP_2 &mc_virt SLAVE_EBI1>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&qupv3_se16_i2c_sda_active>, <&qupv3_se16_i2c_scl_active>;
			pinctrl-1 = <&qupv3_se16_i2c_sleep>;
			dmas = <&gpi_dma2 0 0 3 64 0>,
			       <&gpi_dma2 1 0 3 64 0>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		qupv3_se16_spi: spi@880000 {
			compatible = "qcom,spi-geni";
			reg = <0x0 0x880000 0x0 0x4000>;
			reg-names = "se_phys";
			interrupts = <GIC_SPI 808 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "se-clk";
			clocks = <&gcc GCC_QUPV3_WRAP2_S0_CLK>;
