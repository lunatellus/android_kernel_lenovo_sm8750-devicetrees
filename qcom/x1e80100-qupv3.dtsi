					<&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_2>,
					<&aggre1_noc MASTER_QUP_2 &mc_virt SLAVE_EBI1>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&qupv3_se16_spi_mosi_active>, <&qupv3_se16_spi_miso_active>,
				    <&qupv3_se16_spi_clk_active>, <&qupv3_se16_spi_cs_active>;
			pinctrl-1 = <&qupv3_se16_spi_sleep>;
			dmas = <&gpi_dma2 0 0 1 64 0>,
			       <&gpi_dma2 1 0 1 64 0>;
			dma-names = "tx", "rx";
			spi-max-frequency = <50000000>;
			status = "disabled";
		};

