		};

		qupv3_se7_spi: spi@b9c000 {
			compatible = "qcom,spi-geni";
			reg = <0x0 0xb9c000 0x0 0x4000>;
			reg-names = "se_phys";
			interrupts = <GIC_SPI 462 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "se-clk";
			clocks = <&gcc GCC_QUPV3_WRAP0_S7_CLK>;
			interconnect-names = "qup-core", "qup-config", "qup-memory";
			interconnects = <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
					<&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
					<&aggre1_noc MASTER_QUP_0 &mc_virt SLAVE_EBI1>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&qupv3_se7_spi_mosi_active>, <&qupv3_se7_spi_miso_active>,
				    <&qupv3_se7_spi_clk_active>, <&qupv3_se7_spi_cs_active>;
			pinctrl-1 = <&qupv3_se7_spi_sleep>;
			dmas = <&gpi_dma0 0 7 1 64 0>,
			       <&gpi_dma0 1 7 1 64 0>;
			dma-names = "tx", "rx";
			spi-max-frequency = <50000000>;
			status = "disabled";
		};
	};

	qup1_gpi_iommu_region: qup1_gpi_iommu_region {
		iommu-addresses = <&gpi_dma1 0x0 0x0 0x0 0x100000>,
				  <&gpi_dma1 0x0 0x200000 0xffffffff 0xffe00000>;
	};

	gpi_dma1: qcom,gpi-dma@a00000 {
		compatible = "qcom,gpi-dma";
		#dma-cells = <5>;
		reg = <0x0 0xa00000 0x0 0x60000>;
		reg-names = "gpi-top";
		iommus = <&apps_smmu 0X0136 0x0>;
		qcom,max-num-gpii = <12>;
		interrupts = <GIC_SPI 776 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 777 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 778 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 779 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 780 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 781 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 782 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 783 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 784 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 785 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 786 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 787 IRQ_TYPE_LEVEL_HIGH>;
		qcom,gpii-mask = <0x3f>;
		qcom,ev-factor = <1>;
		memory-region = <&qup1_gpi_iommu_region>;
		qcom,gpi-ee-offset = <0x10000>;
		dma-coherent;
		status = "okay";
	};

	qup1_se_iommu_region: qup1_se_iommu_region {
		iommu-addresses = <&qupv3_id_1 0x0 0x0 0x0 0x40000000>,
				  <&qupv3_id_1 0x0 0x50000000 0xffffffff 0xb0000000>;
	};

	qupv3_id_1: qcom,qupv3_1_geni_se@ac0000 {
		compatible = "qcom,geni-se-qup";
		reg = <0x0 0xac0000 0x0 0x2000>;
		clock-names = "m-ahb", "s-ahb";
		clocks = <&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
			 <&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
		iommus = <&apps_smmu 0x0123 0x0>;
		memory-region = <&qup1_se_iommu_region>;
		qcom,iommu-geometry = <0x0 0x40000000 0x0 0x10000000>;
		qcom,iommu-dma = "fastmap";
		dma-coherent;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		status = "okay";

