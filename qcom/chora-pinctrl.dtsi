	/* WCD reset pin */
	wcd939x_reset_active: wcd939x_reset_active {
		mux {
			pins = "gpio106";
			function = "gpio";
		};

		config {
			pins = "gpio106";
			drive-strength = <16>;
			output-high;
		};
	};

